# Required: the PostgreSQL password.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Required: shared secret between the web app and the updater sidecar.
# Generate with: openssl rand -hex 32
UPDATER_SECRET=change-me-to-a-long-random-secret

# Required: absolute path of this folder on the Docker host. The updater uses
# it so docker compose can recreate the web container with the same volumes.
STACK_DIR=/opt/stacks/opcontrol-parental

# Optional: public address families and emails use to reach this server.
PUBLIC_BASE_URL=https://parental.example.com

# Optional: image references. The updater changes WEB_IMAGE for the web
# container when it installs a new release.
WEB_IMAGE=ghcr.io/ziur-vela/parental-opcontrol:latest
UPDATER_IMAGE=ghcr.io/ziur-vela/parental-opcontrol-updater:latest

# Optional: bind address and host port for the web interface.
WEB_BIND=127.0.0.1
WEB_PORT=8096

# Optional: compose project name. Keep it in sync with STACK_DIR.
COMPOSE_PROJECT_NAME=opcontrol-parental
