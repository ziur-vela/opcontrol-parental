<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>OpControl.Parental.Helper</AssemblyName>
    <RootNamespace>OpControl.Parental.Helper</RootNamespace>
    <Version>0.9.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpControl.Parental.Contracts\OpControl.Parental.Contracts.csproj" />
    <Compile Include="..\OpControl.Parental.Client.Windows\AppIdentity.cs" Link="AppIdentity.cs" />
    <EmbeddedResource Include="brand\lockup-ondark-300h.png" />
    <EmbeddedResource Include="brand\icon-color-128.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="fonts\*.ttf" />
  </ItemGroup>
</Project>
