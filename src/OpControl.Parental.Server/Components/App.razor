@inject IStringLocalizer<OpControl.Parental.Server.Resources.AppStrings> L
@inject OpControl.Parental.Server.Services.BuildInfo BuildInfo
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Parental OpControl</title>
    <link rel="icon" type="image/x-icon" href="/brand/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="@(Light ? "#f1f4f1" : "#0b1714")" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="OpControl" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    <link rel="stylesheet" href="/css/parental.css?v=@BuildInfo.ShortCommit" />
    <HeadOutlet />
</head>
<body class="@(Light ? "t-light" : "t-dark")">
    <Routes />
    <script src="/_framework/blazor.web.js"></script>
    <script src="/js/app.js?v=@BuildInfo.ShortCommit"></script>
    <script src="/js/remote.js?v=@BuildInfo.ShortCommit"></script>
    <script src="/js/push.js?v=@BuildInfo.ShortCommit"></script>
    <script>
        window.ocpStrings = @(new Microsoft.AspNetCore.Html.HtmlString(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, string>
        {
            ["requesting"] = L["Js.Requesting"],
            ["updateRequested"] = L["Js.UpdateRequested"],
            ["updateFailed"] = L["Js.UpdateFailed"],
            ["connectionError"] = L["Js.ConnectionError"],
            ["connecting"] = L["Js.Connecting"],
            ["live"] = L["Js.Live"],
            ["sessionCreating"] = L["Js.SessionCreating"],
            ["sessionStartFailed"] = L["Js.SessionStartFailed"],
            ["sessionWaiting"] = L["Js.SessionWaiting"],
            ["cameraLive"] = L["Js.CameraLive"],
            ["screenLive"] = L["Js.ScreenLive"],
            ["sessionEnded"] = L["Js.SessionEnded"]
        })));
    </script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The saved theme is also kept in a cookie so the server renders it. Blazor copies the
    // server-rendered body class on every page change, so it must match the parent's choice.
    private bool Light => HttpContext?.Request.Cookies["ocp.theme"] == "light";
}
