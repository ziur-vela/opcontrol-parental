@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject DashboardEventBus Events
@inject BuildInfo Build
@inject Microsoft.Extensions.Options.IOptions<BrandOptions> BrandOptions
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L
@implements IDisposable

@{
    var brand = BrandOptions.Value;
}
<style>:root { --brand: @brand.AccentColor; }</style>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand-row">
            <img src="@brand.LogoDark" alt="@brand.ProductName" class="brand-logo brand-dark" />
            <img src="@brand.LogoLight" alt="@brand.ProductName" class="brand-logo brand-light" />
        </div>
        <nav class="nav">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All"><span class="nav-ico">⌂</span> @L["Nav.Home"]</NavLink>
            @if (Can(PermissionFlags.ViewReports))
            {
                <NavLink class="nav-link" href="/screen-time"><span class="nav-ico">◔</span> @L["Nav.ScreenTime"]</NavLink>
                <NavLink class="nav-link" href="/activity"><span class="nav-ico">≡</span> @L["Nav.Activity"]</NavLink>
            }
            @if (Can(PermissionFlags.WebsiteRules))
            {
                <NavLink class="nav-link" href="/websites"><span class="nav-ico">◎</span> @L["Nav.Websites"]</NavLink>
            }
            @if (Can(PermissionFlags.AppRules))
            {
                <NavLink class="nav-link" href="/apps"><span class="nav-ico">▤</span> @L["Nav.Apps"]</NavLink>
            }
            @if (Can(PermissionFlags.ManageDevices))
            {
                <NavLink class="nav-link" href="/devices"><span class="nav-ico">▣</span> @L["Nav.Devices"]</NavLink>
            }
            @if (Can(PermissionFlags.RemoteView))
            {
                <NavLink class="nav-link" href="/remote"><span class="nav-ico">◉</span> @L["Nav.Remote"]</NavLink>
            }
            @if (Can(PermissionFlags.SchedulesLimits))
            {
                <NavLink class="nav-link" href="/schedules"><span class="nav-ico">◷</span> @L["Nav.Schedules"]</NavLink>
            }
            @if (Can(PermissionFlags.ViewReports))
            {
                <NavLink class="nav-link" href="/alerts">
                    <span class="nav-ico">◉</span> @L["Nav.Alerts"]
                    @if (_unread > 0) { <span class="nav-count">@_unread</span> }
                </NavLink>
            }
            @if (Can(PermissionFlags.ManageDevices))
            {
                <NavLink class="nav-link" href="/add-device"><span class="nav-ico">＋</span> @L["Nav.AddDevice"]</NavLink>
                <NavLink class="nav-link" href="/downloads"><span class="nav-ico">⤓</span> @L["Nav.Downloads"]</NavLink>
            }
            @if (_isOwner)
            {
                <NavLink class="nav-link" href="/team"><span class="nav-ico">👥</span> @L["Nav.Parents"]</NavLink>
            }
            @if (_isServerAdmin)
            {
                <NavLink class="nav-link" href="/server-admin"><span class="nav-ico">☷</span> @L["Nav.ServerAdmin"]</NavLink>
            }
            <NavLink class="nav-link" href="/settings"><span class="nav-ico">⚙</span> @L["Nav.Settings"]</NavLink>
        </nav>
        <div class="sidebar-foot">
            <div class="pill-soft">@Build.DisplayVersion</div>
            <div class="muted small">@brand.ProductName</div>
            <a class="muted small" href="/settings">@L["Layout.VersionDetails"]</a>
        </div>
    </aside>

    <div class="main-col">
        <header class="topbar">
            <div class="topbar-title">@L["Layout.FamilyDashboard"]</div>
            <div class="topbar-actions">
                <button type="button" class="icon-btn" onclick="ocpToggleTheme()" title="@L["Layout.ToggleTheme"]" aria-label="@L["Layout.ToggleTheme"]">◐</button>
                <span class="lang-switch" role="group" aria-label="@L["Layout.Language"]">
                    <a class="lang-link @(IsSpanish ? "" : "active")" href="/language/en?returnUrl=@CurrentPath" title="@L["Language.English"]">EN</a>
                    <a class="lang-link @(IsSpanish ? "active" : "")" href="/language/es-MX?returnUrl=@CurrentPath" title="@L["Language.Spanish"]">ES</a>
                </span>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <span class="user-chip">@auth.User.FindFirst("display_name")?.Value</span>
                    </Authorized>
                </AuthorizeView>
                <form method="post" action="/logout" class="inline-form">
                    <AntiforgeryToken />
                    <button type="submit" class="ghost-btn">@L["Layout.SignOut"]</button>
                </form>
            </div>
        </header>
        <main class="content">
            @Body
            <div class="site-foot">@L["Layout.CreatedBy"]</div>
        </main>
    </div>
</div>

<form id="af-form" method="post" class="hidden-form" aria-hidden="true">
    <AntiforgeryToken />
</form>

@code {
    private int _unread;
    private bool _isOwner;
    private bool _isServerAdmin;
    private ParentPermissions _permissions;

    [Flags]
    private enum PermissionFlags
    {
        None = 0,
        LockUnlockBonus = 1,
        WebsiteRules = 2,
        AppRules = 4,
        SchedulesLimits = 8,
        ViewReports = 16,
        ManageDevices = 32,
        ManagePin = 64,
        RemoteView = 128
    }

    private bool IsSpanish => System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("es", StringComparison.OrdinalIgnoreCase);

    private string CurrentPath
    {
        get
        {
            var uri = new Uri(Nav.Uri);
            var value = uri.PathAndQuery;
            return Uri.EscapeDataString(value);
        }
    }

    private bool Can(PermissionFlags permission) =>
        _isOwner || ((int)_permissions & (int)permission) == (int)permission;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _isOwner = string.Equals(auth.User.FindFirst("family_role")?.Value, "Owner", StringComparison.OrdinalIgnoreCase);
        _isServerAdmin = string.Equals(auth.User.FindFirst("server_admin")?.Value, "true", StringComparison.OrdinalIgnoreCase);
        _permissions = int.TryParse(auth.User.FindFirst("permissions")?.Value, out var value) ? (ParentPermissions)value : ParentPermissions.None;
        Events.AlertChanged += OnAlertChanged;
        await RefreshAsync();
    }

    private void OnAlertChanged(OpControl.Parental.Server.Data.Alert alert) =>
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private async Task RefreshAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out var familyId)) return;
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var child = await db.Children.AsNoTracking()
                .Where(c => c.FamilyId == familyId)
                .OrderBy(c => c.CreatedUtc)
                .Select(c => (Guid?)c.Id)
                .FirstOrDefaultAsync();
            if (child is not { } childId) return;
            _unread = await db.Alerts.AsNoTracking().CountAsync(a => a.FamilyId == familyId && a.ChildId == childId && a.ReadUtc == null);
        }
        catch { }
    }

    public void Dispose() => Events.AlertChanged -= OnAlertChanged;
}
