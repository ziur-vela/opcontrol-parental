@inherits LayoutComponentBase
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject DashboardEventBus Events
@implements IDisposable

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand-row">
            <img src="/brand/lockup-ondark.svg" alt="Parental OpControl" class="brand-logo brand-dark" />
            <img src="/brand/lockup-color.svg" alt="Parental OpControl" class="brand-logo brand-light" />
        </div>
        <nav class="nav">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
                <span class="nav-ico">⌂</span> Home
            </NavLink>
            <NavLink class="nav-link" href="/screen-time">
                <span class="nav-ico">◔</span> Screen time
            </NavLink>
            <NavLink class="nav-link" href="/activity">
                <span class="nav-ico">≡</span> Activity
            </NavLink>
            <NavLink class="nav-link" href="/websites">
                <span class="nav-ico">◎</span> Websites
            </NavLink>
            <NavLink class="nav-link" href="/apps">
                <span class="nav-ico">▤</span> Apps
            </NavLink>
            <NavLink class="nav-link" href="/devices">
                <span class="nav-ico">▣</span> Devices
            </NavLink>
            <NavLink class="nav-link" href="/schedules">
                <span class="nav-ico">◷</span> Schedules
            </NavLink>
            <NavLink class="nav-link" href="/alerts">
                <span class="nav-ico">◉</span> Alerts
                @if (_unread > 0)
                {
                    <span class="nav-count">@_unread</span>
                }
            </NavLink>
            <NavLink class="nav-link" href="/add-device">
                <span class="nav-ico">＋</span> Add device
            </NavLink>
            <NavLink class="nav-link" href="/downloads">
                <span class="nav-ico">⤓</span> Downloads
            </NavLink>
            <NavLink class="nav-link" href="/settings">
                <span class="nav-ico">⚙</span> Settings
            </NavLink>
        </nav>
        <div class="sidebar-foot">
            <div class="pill-soft">Job 5A</div>
            <div class="muted small">Installer, add-device links, auto-update and hardening.</div>
        </div>
    </aside>

    <div class="main-col">
        <header class="topbar">
            <div class="topbar-title">Family dashboard</div>
            <div class="topbar-actions">
                <button type="button" class="icon-btn" onclick="ocpToggleTheme()" title="Toggle theme" aria-label="Toggle theme">◐</button>
                <AuthorizeView>
                    <Authorized Context="auth">
                        <span class="user-chip">@auth.User.FindFirst("display_name")?.Value</span>
                    </Authorized>
                </AuthorizeView>
                <form method="post" action="/logout" class="inline-form">
                    <AntiforgeryToken />
                    <button type="submit" class="ghost-btn">Sign out</button>
                </form>
            </div>
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>

<form id="af-form" method="post" class="hidden-form" aria-hidden="true">
    <AntiforgeryToken />
</form>

@code {
    private int _unread;

    protected override async Task OnInitializedAsync()
    {
        Events.AlertChanged += OnAlertChanged;
        await RefreshAsync();
    }

    private void OnAlertChanged(OpControl.Parental.Server.Data.Alert alert) =>
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private async Task RefreshAsync()
    {
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out var familyId)) return;
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var child = await db.Children.AsNoTracking()
                .Where(c => c.FamilyId == familyId)
                .OrderBy(c => c.CreatedUtc)
                .Select(c => (Guid?)c.Id)
                .FirstOrDefaultAsync();
            if (child is not { } childId) return;
            _unread = await db.Alerts.AsNoTracking().CountAsync(a => a.FamilyId == familyId && a.ChildId == childId && a.ReadUtc == null);
        }
        catch { }
    }

    public void Dispose() => Events.AlertChanged -= OnAlertChanged;
}
