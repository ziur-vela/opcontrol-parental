@page "/activity"
@attribute [Authorize(Policy = ParentalPolicies.ViewReports)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Activity.PageTitle"]</PageTitle>

@if (_loading)
{
    <div class="card"><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
}
else if (_childId == Guid.Empty)
{
    <div class="card"><h1>@L["Common.NoChildYet"]</h1><p class="muted">@L["Common.CreateChildFirst"]</p></div>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">@_childName</div>
            <h1>@L["Nav.Activity"]</h1>
            <p class="muted">@L["Activity.Subtitle"]</p>
        </div>
        <div class="button-row">
            <a class="btn btn-ghost" href="/screen-time">@L["Nav.ScreenTime"]</a>
            <a class="btn btn-ghost" href="/alerts">@L["Nav.Alerts"]</a>
        </div>
    </div>

    <section class="stat-grid">
        <div class="card stat-card">
            <div class="eyebrow">@L["Activity.ActiveToday"]</div>
            <div class="stat-value">@FormatDuration(_activeToday)</div>
        </div>
        <div class="card stat-card">
            <div class="eyebrow">@L["Activity.IdleToday"]</div>
            <div class="stat-value">@FormatDuration(_idleToday)</div>
        </div>
        <div class="card stat-card">
            <div class="eyebrow">@L["Activity.BlockedToday"]</div>
            <div class="stat-value">@_blockedToday</div>
        </div>
        <div class="card stat-card">
            <div class="eyebrow">@L["Activity.Events"]</div>
            <div class="stat-value">@_events.Count</div>
            <div class="muted tiny">@L["Activity.Latest200"]</div>
        </div>
    </section>

    <section class="card">
        <div class="card-title-row">
            <h2>@L["Activity.Timeline"]</h2>
            <span class="pill-soft">@_timeZoneId</span>
        </div>
        @if (_events.Count == 0)
        {
            <p class="muted">@L["Activity.NoActivity"]</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var item in _events)
                {
                    <div class="timeline-row">
                        <div class="timeline-icon @item.Tone">@item.Icon</div>
                        <div class="timeline-main">
                            <div class="timeline-title">@item.Title</div>
                            <div class="muted tiny">@item.Detail</div>
                        </div>
                        <div class="muted tiny">@FormatLocal(item.WhenUtc)</div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private sealed record EventRow(DateTime WhenUtc, string Icon, string Tone, string Title, string Detail);

    private Guid _familyId;
    private Guid _childId;
    private string _childName = "";
    private string _timeZoneId = "UTC";
    private bool _loading = true;
    private int _activeToday;
    private int _idleToday;
    private int _blockedToday;
    private List<EventRow> _events = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
        {
            _loading = false;
            return;
        }
        await RefreshAsync();
        _loading = false;
    }

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var child = await db.Children.AsNoTracking().Where(c => c.FamilyId == _familyId).OrderBy(c => c.CreatedUtc).FirstOrDefaultAsync();
        if (child is null) { _childId = Guid.Empty; return; }
        _childId = child.Id;
        _childName = child.Name;
        _timeZoneId = await db.Devices.AsNoTracking().Where(d => d.ChildId == child.Id).Select(d => d.TimeZoneId).FirstOrDefaultAsync() ?? "UTC";
        var tz = TimeZoneResolver.Resolve(_timeZoneId);
        var (start, end) = UsageService.LocalDayBounds(tz, DateTime.UtcNow);

        _activeToday = await db.UsageIntervals.AsNoTracking()
            .Where(u => u.ChildId == child.Id && u.Active && u.StartUtc >= start && u.StartUtc < end)
            .SumAsync(u => (int?)u.DurationSeconds) ?? 0;
        _idleToday = await db.UsageIntervals.AsNoTracking()
            .Where(u => u.ChildId == child.Id && !u.Active && u.StartUtc >= start && u.StartUtc < end)
            .SumAsync(u => (int?)u.DurationSeconds) ?? 0;
        _blockedToday = await db.VisitRecords.AsNoTracking()
            .CountAsync(v => v.ChildId == child.Id && v.Blocked && v.VisitedUtc >= start && v.VisitedUtc < end);

        var rows = new List<EventRow>();
        var parentNames = await db.Users.AsNoTracking()
            .Where(u => u.FamilyId == _familyId)
            .ToDictionaryAsync(u => u.Id, u => u.DisplayName);
        var overrides = await db.OverrideEvents.AsNoTracking()
            .Where(e => e.FamilyId == _familyId && e.ChildId == child.Id)
            .OrderByDescending(e => e.CreatedUtc).Take(120).ToListAsync();
        rows.AddRange(overrides.Select(e => new EventRow(e.CreatedUtc, OverrideIcon(e.Option), OverrideTone(e.Option),
            OverrideTitle(e.Option) + (e.CreatedByParentId is { } changedBy && parentNames.TryGetValue(changedBy, out var byName) ? L["Activity.By", byName] : ""),
            OverrideDetail(e))));

        var ruleHistory = await db.RuleHistory.AsNoTracking()
            .Where(h => h.FamilyId == _familyId && h.ChildId == child.Id)
            .OrderByDescending(h => h.ChangedUtc).Take(80).ToListAsync();
        rows.AddRange(ruleHistory.Select(h => new EventRow(h.ChangedUtc, "◎", "accent",
            RuleActionTitle(h.RuleType, h.Action) +
            (h.ChangedByParentId is { } changedBy && parentNames.TryGetValue(changedBy, out var byName) ? L["Activity.By", byName] : ""),
            h.DisplayName)));

        var blocks = await db.BlockEvents.AsNoTracking()
            .Where(b => b.FamilyId == _familyId && b.ChildId == child.Id)
            .OrderByDescending(b => b.OccurredUtc).Take(80).ToListAsync();
        rows.AddRange(blocks.Select(b => new EventRow(b.OccurredUtc, "⊘", "danger",
            b.RuleType == "site" ? L["Activity.WebsiteBlocked"] : L["Activity.AppBlocked"], b.DisplayName)));

        var installs = await db.InstalledApps.AsNoTracking()
            .Where(a => a.FamilyId == _familyId && a.ChildId == child.Id && a.IsNew)
            .OrderByDescending(a => a.FirstSeenUtc).Take(40).ToListAsync();
        rows.AddRange(installs.Select(a => new EventRow(a.FirstSeenUtc, "＋", "accent", L["Activity.NewAppInstalled"], a.DisplayName)));

        var alerts = await db.Alerts.AsNoTracking()
            .Where(a => a.FamilyId == _familyId && a.ChildId == child.Id)
            .OrderByDescending(a => a.CreatedUtc).Take(80).ToListAsync();
        rows.AddRange(alerts.Select(a =>
        {
            var (title, detail) = AlertText.Render(a);
            return new EventRow(a.CreatedUtc, AlertIcon(a.Type), AlertTone(a.Type), title, detail);
        }));

        var tamper = await db.ClientTamperEvents.AsNoTracking()
            .Where(t => t.FamilyId == _familyId && t.ChildId == child.Id)
            .OrderByDescending(t => t.OccurredUtc).Take(40).ToListAsync();
        rows.AddRange(tamper.Select(t =>
        {
            var (title, detail) = TamperText(t);
            return new EventRow(t.OccurredUtc, "!", "warn", title, detail);
        }));

        _events = rows.OrderByDescending(r => r.WhenUtc).Take(200).ToList();
    }

    private string FormatLocal(DateTime utc) =>
        Formats.CompactDateTime(TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneResolver.Resolve(_timeZoneId)));

    private static string FormatDuration(int seconds) => Formats.Duration(seconds);

    private string RuleActionTitle(string ruleType, RuleAction action)
    {
        var key = ruleType == "site"
            ? action switch { RuleAction.Blocked => "Activity.SiteRuleBlocked", RuleAction.Allowed => "Activity.SiteRuleAllowed", _ => "Activity.SiteRuleRemoved" }
            : action switch { RuleAction.Blocked => "Activity.AppRuleBlocked", RuleAction.Allowed => "Activity.AppRuleAllowed", _ => "Activity.AppRuleRemoved" };
        return L[key];
    }

    private static string OverrideIcon(string option) => option switch
    {
        "dashboard-lock" or "pin-lock" => "▣",
        "dashboard-unlock" or "pin-unlock-until-next" => "▢",
        "schedule-start" or "schedule-end" or "schedule-added" or "schedule-toggled" or "schedule-removed" => "◷",
        "daily-limit-reached" or "screen-time-limit-set" or "screen-time-limit-disabled" => "◔",
        _ => "✦"
    };

    private static string OverrideTone(string option) => option switch
    {
        "daily-limit-reached" => "danger",
        "schedule-start" or "schedule-end" => "warn",
        _ => "accent"
    };

    private string OverrideTitle(string option) => option switch
    {
        "dashboard-lock" => L["Activity.Option.DashboardLock"],
        "dashboard-unlock" => L["Activity.Option.DashboardUnlock"],
        "dashboard-bonus" => L["Activity.Option.DashboardBonus"],
        "pin-unlock-until-next" => L["Activity.Option.PinUnlock"],
        "pin-bonus" => L["Activity.Option.PinBonus"],
        "schedule-start" => L["Activity.Option.ScheduleStarted"],
        "schedule-end" => L["Activity.Option.ScheduleEnded"],
        "schedule-added" => L["Activity.Option.ScheduleAdded"],
        "schedule-toggled" => L["Activity.Option.ScheduleChanged"],
        "schedule-removed" => L["Activity.Option.ScheduleRemoved"],
        "screen-time-limit-set" => L["Activity.Option.LimitSet"],
        "screen-time-limit-disabled" => L["Activity.Option.LimitDisabled"],
        "category-toggled" => L["Activity.Option.CategoryChanged"],
        "app-limit-set" => L["Activity.Option.AppLimitSet"],
        "app-limit-removed" => L["Activity.Option.AppLimitRemoved"],
        "app-always-allowed" => L["Common.AlwaysAllowed"],
        "remote-notice-changed" => L["Activity.Option.NoticeChanged"],
        "daily-limit-reached" => L["Home.StatusDailyLimit"],
        "item-bonus-site" => L["Activity.Option.SiteBonus"],
        "item-bonus-app" => L["Activity.Option.AppBonus"],
        _ => option
    };

    private string OverrideDetail(OverrideEvent e)
    {
        if (e.Option == "remote-notice-changed" && e.Detail is { } notice)
        {
            var parts = notice.Split('|');
            if (parts.Length == 4)
                return L["Activity.NoticeDetail", parts[0], YesNo(parts[1]), YesNo(parts[2]), YesNo(parts[3])];
        }
        if (e.Option == "category-toggled" && e.Detail is { } category)
        {
            var parts = category.Split('|');
            if (parts.Length == 2)
            {
                var name = CategoryText.Name(parts[0], parts[0]);
                return L[parts[1] == "1" ? "Activity.CategoryBlocked" : "Activity.CategoryAllowed", name];
            }
        }
        if (e.Option == "daily-limit-reached" && DateTime.TryParse(e.Detail, out var day))
            return L["Activity.DailyLimitDetail", day.ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture)];
        if (e.Option.StartsWith("schedule", StringComparison.Ordinal)) return e.Detail ?? "";
        if (e.Minutes is { } minutes) return L["Common.Minutes", minutes] + (e.Detail is null ? "" : $" · {e.Detail}");
        return e.Detail ?? "";
    }

    private string YesNo(string value) => value == "1" ? L["Common.Yes"] : L["Common.No"];

    private string LegacyHelperKilled(string detail)
    {
        var match = System.Text.RegularExpressions.Regex.Match(detail, @"killed (\d+) times");
        return match.Success ? L["Activity.Tamper.HelperKilledDetail", match.Groups[1].Value] : "";
    }

    private string LegacyClock(string detail)
    {
        var match = System.Text.RegularExpressions.Regex.Match(detail, @"(\d+) minutes");
        return match.Success ? L["Activity.Tamper.Minutes", match.Groups[1].Value] : "";
    }

    private (string Title, string Detail) TamperText(ClientTamperEvent item)
    {
        var detail = item.Detail ?? "";
        return item.Kind switch
        {
            "service-stopped" => (L["Activity.Tamper.ServiceStopped"], ""),
            "helper-killed" => (L["Activity.Tamper.HelperKilled"],
                int.TryParse(detail, out var count) ? L["Activity.Tamper.HelperKilledDetail", count]
                : LegacyHelperKilled(detail)),
            "helper-auth-failed" => (L["Activity.Tamper.HelperAuth"], detail),
            "dns-settings-changed" => (L["Activity.Tamper.Dns"], ""),
            "clock-changed" => (L["Activity.Tamper.Clock"],
                int.TryParse(detail, out var minutes) ? L["Activity.Tamper.Minutes", minutes] : LegacyClock(detail)),
            "uninstall-attempted" => (L["Activity.Tamper.Uninstall"], detail),
            "usage-sanity" => (L["Activity.Tamper.UsageSanity"], detail),
            _ => (L["Activity.ClientTampering"], detail)
        };
    }

    private static string AlertIcon(string type) => type switch
    {
        "new-app" => "＋",
        "repeated-blocked-site" => "⊘",
        "pin-override" => "✦",
        "daily-limit" or "app-limit" => "◔",
        "device-offline" => "⇄",
        "tampering" => "!",
        "child-message" => "✉",
        _ => "◉"
    };

    private static string AlertTone(string type) => type switch
    {
        "repeated-blocked-site" or "daily-limit" or "app-limit" => "danger",
        "device-offline" or "tampering" => "warn",
        "child-message" => "accent",
        _ => "accent"
    };
}
