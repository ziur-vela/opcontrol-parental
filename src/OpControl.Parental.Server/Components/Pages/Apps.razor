@page "/apps"
@attribute [Authorize(Policy = ParentalPolicies.AppRules)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Apps.PageTitle"]</PageTitle>

@if (_loading)
{
    <div class="card"><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
}
else if (_childId == Guid.Empty)
{
    <div class="card"><h1>@L["Common.NoChildYet"]</h1><p class="muted">@L["Common.CreateChildFirst"]</p></div>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">@_childName</div>
            <h1>@L["Nav.Apps"]</h1>
            <p class="muted">@L["Apps.Subtitle"]</p>
        </div>
        <div class="button-row">
            <a class="btn btn-ghost" href="/websites">@L["Nav.Websites"]</a>
            <a class="btn btn-ghost" href="/schedules">@L["Nav.Schedules"]</a>
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="alert danger">@_error</div>
    }

    <section class="card">
        <div class="card-title-row">
            <h2>@L["Apps.NewToReview"]</h2>
            <span class="pill-soft">@L["Apps.NewCount", _newApps.Count]</span>
        </div>
        @if (_newApps.Count == 0)
        {
            <p class="muted">@L["Apps.NothingNew"]</p>
        }
        else
        {
            <div class="app-grid">
                @foreach (var app in _newApps)
                {
                    <div class="app-card">
                        <div class="app-badge">@Initial(app.DisplayName)</div>
                        <div class="app-main">
                            <div class="rule-title">@app.DisplayName <span class="pill-soft tiny-pill">@L["Apps.New"]</span></div>
                            <div class="muted tiny">@SourceLabel(app.Source) · @(string.IsNullOrWhiteSpace(app.Publisher) ? L["Apps.UnknownPublisher"] : app.Publisher)</div>
                            <div class="muted tiny">@L["Apps.FirstSeen", app.DeviceName, FormatLocal(app.FirstSeenUtc)]</div>
                        </div>
                        <div class="rule-actions">
                            <button class="btn btn-accent" @onclick="() => BlockAppAsync(app)">@L["Common.Block"]</button>
                            <button class="ghost-btn" @onclick="() => AllowAppAsync(app)">@L["Common.Allow"]</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <div class="grid-2">
        <section class="card">
            <div class="card-title-row">
                <h2>@L["Apps.Installed"]</h2>
                <span class="pill-soft">@L["Apps.InstalledCount", _installed.Count, L[_deviceCount == 1 ? "Common.DeviceCount" : "Common.DeviceCountPlural", _deviceCount]]</span>
            </div>

            <form class="inline-add" @onsubmit="AddManualAsync" @onsubmit:preventDefault>
                <input class="mini-input grow" placeholder="@L["Apps.AddByPath"]" @bind="_manualPath" />
                <input class="mini-input" placeholder="@L["Apps.DisplayNameOptional"]" @bind="_manualName" />
                <button class="btn btn-primary" type="submit">@L["Apps.Add"]</button>
            </form>

            <div class="chip-row">
                @foreach (var filter in Filters)
                {
                    <button class="chip @(_filter == filter.Key ? "active" : "")" @onclick="() => SetFilter(filter.Key)">@L[filter.LabelKey]</button>
                }
            </div>
            <input class="mini-input" placeholder="@L["Apps.Search"]" @bind="_search" @bind:after="ApplyFilter" />

            <div class="rule-list">
                @foreach (var app in _filtered)
                {
                    <div class="rule-row">
                        <div class="app-badge small">@Initial(app.DisplayName)</div>
                        <div class="rule-main">
                            <div class="rule-title">@app.DisplayName</div>
                            <div class="muted tiny">
                                @SourceLabel(app.Source)
                                @if (!string.IsNullOrWhiteSpace(app.Version))
                                {
                                    <span> · @app.Version</span>
                                }
                                @if (app.IsNew)
                                {
                                    <span class="pill-soft tiny-pill">@L["Apps.New"]</span>
                                }
                            </div>
                            <div class="muted tiny">@(string.IsNullOrWhiteSpace(app.Publisher) ? L["Apps.UnknownPublisher"] : app.Publisher)</div>
                        </div>
                        <div class="rule-actions">
                            @if (app.Blocked)
                            {
                                <span class="state-pill blocked">@L["Common.Blocked"]</span>
                                <button class="ghost-btn" @onclick="() => RemoveRuleAsync(app.RuleId)">@L["Websites.Unblock"]</button>
                            }
                            else if (app.Allowed)
                            {
                                <span class="state-pill allowed">@(app.AlwaysAllowed ? L["Common.AlwaysAllowed"] : L["Apps.Limited", app.LimitMinutes ?? 0])</span>
                                <button class="ghost-btn" @onclick="() => BlockAppAsync(app)">@L["Common.Block"]</button>
                                @if (app.LimitMinutes is not null)
                                {
                                    <button class="ghost-btn" @onclick="() => AllowAppAsync(app)">@L["Apps.RemoveLimit"]</button>
                                }
                            }
                            else
                            {
                                <button class="btn btn-accent" @onclick="() => BlockAppAsync(app)">@L["Common.Block"]</button>
                                <button class="ghost-btn" @onclick="() => AllowAppAsync(app)">@L["Common.Allow"]</button>
                            }
                            @if (!app.Blocked)
                            {
                                <button class="ghost-btn" @onclick="() => LimitAppAsync(app)">@L["ScreenTime.Limit1h"]</button>
                            }
                            @if (app.Blocked)
                            {
                                <button class="ghost-btn" @onclick="() => BonusAsync(app.Identity, 15)">@L["Home.Bonus15"]</button>
                            }
                        </div>
                    </div>
                }
            </div>
        </section>

        <section class="card">
            <div class="card-title-row">
                <h2>@L["Apps.Rules"]</h2>
                <span class="pill-soft">@L["Websites.RuleCounts", _rules.Count(r => r.IsBlocked), _rules.Count(r => !r.IsBlocked)]</span>
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Websites.BlockedAlways"]</div>
                @foreach (var rule in _rules.Where(r => r.IsBlocked && r.Mode == RuleMode.Always))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@rule.DisplayName</div>
                            <div class="muted tiny">@L["Websites.Since", FormatLocal(rule.UpdatedUtc)]</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => BonusAsync(rule.AppIdentity, 15)">@L["Home.Bonus15"]</button>
                            <button class="ghost-btn" @onclick="() => RemoveRuleAsync(rule.Id)">@L["Websites.Unblock"]</button>
                        </div>
                    </div>
                }
                @if (!_rules.Any(r => r.IsBlocked && r.Mode == RuleMode.Always))
                {
                    <p class="muted tiny">@L["Apps.NoAlwaysBlocked"]</p>
                }
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Websites.BlockedDuringSchedule"]</div>
                @foreach (var rule in _rules.Where(r => r.IsBlocked && r.Mode == RuleMode.Scheduled))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@rule.DisplayName</div>
                            <div class="muted tiny">@ScheduleName(rule.ScheduleId)</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => RemoveRuleAsync(rule.Id)">@L["Websites.Unblock"]</button>
                        </div>
                    </div>
                }
                @if (!_rules.Any(r => r.IsBlocked && r.Mode == RuleMode.Scheduled))
                {
                    <p class="muted tiny">@L["Apps.NoScheduled"]</p>
                }
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Apps.AllowedReviewed"]</div>
                @foreach (var rule in _rules.Where(r => !r.IsBlocked))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@rule.DisplayName</div>
                            <div class="muted tiny">@(rule.AlwaysAllowed ? L["Apps.AlwaysAllowedNote"] : L["Apps.DailyLimitNote", rule.DailyLimitMinutes ?? 0])</div>
                        </div>
                        <div class="rule-actions">
                            @if (rule.DailyLimitMinutes is not null)
                            {
                                <button class="ghost-btn" @onclick="() => ClearAppLimitAsync(rule)">@L["Apps.RemoveLimit"]</button>
                            }
                            <button class="ghost-btn" @onclick="() => BlockAppRuleAsync(rule)">@L["Common.Block"]</button>
                        </div>
                    </div>
                }
                @if (!_rules.Any(r => !r.IsBlocked))
                {
                    <p class="muted tiny">@L["Apps.NoAllowed"]</p>
                }
            </div>
        </section>
    </div>

    <section class="card">
        <div class="card-title-row">
            <h2>@L["Websites.History"]</h2>
            <span class="pill-soft">@L["Websites.LatestCount", Math.Min(_history.Count, 20)]</span>
        </div>
        @if (_history.Count == 0)
        {
            <p class="muted">@L["Apps.NoHistory"]</p>
        }
        else
        {
            <div class="rule-list">
                @foreach (var item in _history.Where(h => h.RuleType == "app").Take(20))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@item.DisplayName</div>
                            <div class="muted tiny">@ActionLabel(item.Action) · @FormatLocal(item.ChangedUtc)</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => BlockIdentityAsync(item.Identity, item.DisplayName, null)">@L["Websites.BlockAgain"]</button>
                            <button class="ghost-btn" @onclick="() => AllowIdentityAsync(item.Identity, item.DisplayName, null)">@L["Websites.AllowAgain"]</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private static readonly (string Key, string LabelKey)[] Filters =
    [
        ("all", "Common.All"),
        ("new", "Apps.New"),
        ("store", "Apps.FilterStore"),
        ("win32", "Apps.FilterWin32"),
        ("notblocked", "Websites.FilterNotBlocked"),
        ("blocked", "Common.Blocked")
    ];

    private sealed class AppRow
    {
        public string Identity { get; init; } = "";
        public string DisplayName { get; init; } = "";
        public string? Publisher { get; init; }
        public string? Version { get; init; }
        public string Source { get; init; } = "win32";
        public string DeviceName { get; init; } = "";
        public DateTime FirstSeenUtc { get; init; }
        public DateTime LastSeenUtc { get; init; }
        public bool IsNew { get; init; }
        public bool Blocked { get; init; }
        public bool Allowed { get; init; }
        public bool AlwaysAllowed { get; init; }
        public int? LimitMinutes { get; init; }
        public Guid RuleId { get; init; }
    }

    private Guid _familyId;
    private Guid _childId;
    private string _childName = "";
    private string _timeZoneId = "UTC";
    private int _deviceCount;
    private bool _loading = true;
    private string? _error;
    private string _filter = "all";
    private string _search = "";
    private string _manualPath = "";
    private string _manualName = "";
    private List<Schedule> _schedules = [];
    private List<AppRule> _rules = [];
    private List<RuleHistoryDto> _history = [];
    private List<AppRow> _installed = [];
    private List<AppRow> _newApps = [];
    private List<AppRow> _filtered = [];

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
        {
            _loading = false;
            _error = L["Home.MissingFamilyScope"];
            return;
        }
        await RefreshAsync();
        _loading = false;
    }

    private void SetFilter(string key)
    {
        _filter = key;
        ApplyFilter();
    }

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var child = await db.Children.AsNoTracking().Where(c => c.FamilyId == _familyId).OrderBy(c => c.CreatedUtc).FirstOrDefaultAsync();
        if (child is null) { _childId = Guid.Empty; return; }
        _childId = child.Id;
        _childName = child.Name;
        _timeZoneId = await db.Devices.AsNoTracking().Where(d => d.ChildId == child.Id).Select(d => d.TimeZoneId).FirstOrDefaultAsync() ?? "UTC";
        _deviceCount = await db.Devices.AsNoTracking().CountAsync(d => d.ChildId == child.Id);

        _rules = await db.AppRules.AsNoTracking()
            .Where(r => r.FamilyId == _familyId && r.ChildId == child.Id)
            .OrderBy(r => r.DisplayName)
            .ToListAsync();
        _schedules = await db.Schedules.AsNoTracking()
            .Where(s => s.FamilyId == _familyId && s.ChildId == child.Id)
            .OrderBy(s => s.Name)
            .ToListAsync();

        var rulesService = scope.ServiceProvider.GetRequiredService<RuleService>();
        _history = await rulesService.GetHistoryAsync(_familyId, child.Id, 80);

        var devices = await db.Devices.AsNoTracking().Where(d => d.ChildId == child.Id).ToDictionaryAsync(d => d.Id, d => d.Name);
        var rows = await db.InstalledApps.AsNoTracking()
            .Where(a => a.FamilyId == _familyId && a.ChildId == child.Id && a.RemovedUtc == null)
            .OrderByDescending(a => a.LastSeenUtc)
            .ToListAsync();

        var apps = new Dictionary<string, AppRow>(StringComparer.OrdinalIgnoreCase);
        foreach (var app in rows)
        {
            if (apps.ContainsKey(app.Identity)) continue;
            var rule = _rules.FirstOrDefault(r => r.AppIdentity.Equals(app.Identity, StringComparison.OrdinalIgnoreCase));
            apps[app.Identity] = new AppRow
            {
                Identity = app.Identity,
                DisplayName = app.DisplayName,
                Publisher = app.Publisher,
                Version = app.Version,
                Source = app.Source,
                DeviceName = devices.GetValueOrDefault(app.DeviceId, "device"),
                FirstSeenUtc = app.FirstSeenUtc,
                LastSeenUtc = app.LastSeenUtc,
                IsNew = app.IsNew && app.ReviewedUtc is null,
                Blocked = rule is { IsBlocked: true },
                Allowed = rule is { IsBlocked: false },
                AlwaysAllowed = rule?.AlwaysAllowed ?? false,
                LimitMinutes = rule?.DailyLimitMinutes,
                RuleId = rule?.Id ?? Guid.Empty
            };
        }

        _installed = apps.Values.OrderBy(a => a.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
        _newApps = _installed.Where(a => a.IsNew).ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = _installed.AsEnumerable();
        query = _filter switch
        {
            "new" => query.Where(a => a.IsNew),
            "store" => query.Where(a => a.Source.Equals("store", StringComparison.OrdinalIgnoreCase)),
            "win32" => query.Where(a => a.Source.Equals("win32", StringComparison.OrdinalIgnoreCase)),
            "notblocked" => query.Where(a => !a.Blocked),
            "blocked" => query.Where(a => a.Blocked),
            _ => query
        };
        if (!string.IsNullOrWhiteSpace(_search))
            query = query.Where(a => a.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (a.Publisher ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));
        _filtered = query.ToList();
    }

    private async Task AddManualAsync()
    {
        if (string.IsNullOrWhiteSpace(_manualPath)) return;
        var identity = AppIdentityPath();
        if (identity.Length == 0)
        {
            _error = L["Apps.EnterFullPath"];
            return;
        }
        var display = string.IsNullOrWhiteSpace(_manualName) ? Path.GetFileName(_manualPath) : _manualName;
        await BlockIdentityAsync(identity, display, null);
        _manualPath = "";
        _manualName = "";
    }

    private string AppIdentityPath()
    {
        var value = _manualPath.Trim().Trim('"');
        if (value.Length == 0) return "";
        return "path:" + value.ToLowerInvariant();
    }

    private Task BlockAppAsync(AppRow app) => BlockIdentityAsync(app.Identity, app.DisplayName, app.Publisher);

    private Task AllowAppAsync(AppRow app) => AllowIdentityAsync(app.Identity, app.DisplayName, app.Publisher);

    private Task BlockAppRuleAsync(AppRule rule) => BlockIdentityAsync(rule.AppIdentity, rule.DisplayName, rule.Publisher);

    private Task LimitAppAsync(AppRow app) => LimitIdentityAsync(app.Identity, app.DisplayName, app.Publisher);

    private async Task LimitIdentityAsync(string identity, string display, string? publisher)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.SetAppLimitAsync(_familyId, _childId, parentId, identity, display, publisher, 60, false);
            await MarkReviewedAsync(db, identity);
        });
    }

    private async Task ClearAppLimitAsync(AppRule rule)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.SetAppLimitAsync(_familyId, _childId, parentId, rule.AppIdentity, rule.DisplayName, rule.Publisher, null, false);
        });
    }

    private async Task BlockIdentityAsync(string identity, string display, string? publisher)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.UpsertAppRuleAsync(_familyId, _childId, parentId, identity, display, publisher, blocked: true, RuleMode.Always, null);
            await MarkReviewedAsync(db, identity);
        });
    }

    private async Task AllowIdentityAsync(string identity, string display, string? publisher)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.UpsertAppRuleAsync(_familyId, _childId, parentId, identity, display, publisher, blocked: false, RuleMode.Always, null);
            await MarkReviewedAsync(db, identity);
        });
    }

    private async Task RemoveRuleAsync(Guid ruleId)
    {
        if (ruleId == Guid.Empty) return;
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.RemoveAppRuleAsync(_familyId, _childId, parentId, ruleId);
            await db.SaveChangesAsync();
        });
    }

    private async Task BonusAsync(string identity, int minutes)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.AddItemBonusAsync(_familyId, _childId, parentId, "app", identity, minutes);
            await db.SaveChangesAsync();
        });
    }

    private async Task MarkReviewedAsync(ParentalDbContext db, string identity)
    {
        var rows = await db.InstalledApps
            .Where(a => a.FamilyId == _familyId && a.ChildId == _childId && a.Identity == identity)
            .ToListAsync();
        foreach (var row in rows)
        {
            row.IsNew = false;
            row.ReviewedUtc = DateTime.UtcNow;
        }
        await db.SaveChangesAsync();
    }

    private async Task RunAsync(Func<ParentalDbContext, RuleService, Guid?, Task> action)
    {
        _error = null;
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var rules = scope.ServiceProvider.GetRequiredService<RuleService>();
            var locks = scope.ServiceProvider.GetRequiredService<LockService>();
            var auth = await AuthState.GetAuthenticationStateAsync();
            Guid? parentId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
            await action(db, rules, parentId);
            await locks.PublishDeviceStateAsync(_familyId, _childId);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private string ScheduleName(Guid? id) => id is { } value ? _schedules.FirstOrDefault(s => s.Id == value)?.Name ?? L["Schedules.ScheduleFallback"] : L["Schedules.NoSchedule"];

    private string FormatLocal(DateTime utc) => Formats.CompactDateTime(
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), ResolveTimeZone(_timeZoneId)));

    private static TimeZoneInfo ResolveTimeZone(string? id) => TimeZoneResolver.Resolve(id);

    private static string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[..1].ToUpperInvariant();

    private static string SourceLabel(string source) => source.Equals("store", StringComparison.OrdinalIgnoreCase) ? "Microsoft Store" : "Win32";

    private string ActionLabel(string action) => action switch
    {
        "Blocked" => L["Common.Blocked"],
        "Allowed" => L["Common.Allowed"],
        "Removed" => L["Websites.RuleRemoved"],
        _ => action
    };
}
