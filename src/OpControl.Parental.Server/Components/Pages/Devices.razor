@page "/devices"
@attribute [Authorize(Policy = ParentalPolicies.ManageDevices)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@using OpControl.Parental.Server.Components.Shared
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject DevicePresenceService Presence
@inject DashboardEventBus Events
@inject OpControl.Parental.Server.Services.ReleaseCatalog Releases
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Devices.PageTitle"]</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">@L["Settings.FamilyEyebrow"]</div>
        <h1>@L["Nav.Devices"]</h1>
        <p class="muted">@L["Devices.Subtitle"]</p>
    </div>
    <a class="btn btn-primary" href="/add-device">@L["Nav.AddDevice"]</a>
</div>

@if (_error is not null)
{
    <div class="alert danger">@_error</div>
}

<div class="card">
    @if (_devices.Count == 0)
    {
        <p class="muted">@L["Devices.None"]</p>
    }
    else
    {
        <div class="device-list">
            @foreach (var device in _devices)
            {
                <div class="device-row">
                    <span class="status-dot @(device.Online ? "online" : "offline")"></span>
                    <div class="device-main">
                        <div class="device-name">@device.Name</div>
                        <div class="muted tiny">@PlatformName(device.Platform) · @(device.TimeZoneId ?? "UTC") · @(device.OsAccountName ?? L["Common.AccountNotReported"])</div>
                        <div class="muted tiny">
                            @(string.IsNullOrWhiteSpace(device.ClientVersion) ? L["Common.VersionUnknown"] : L["Home.ClientVersion", device.ClientVersion])
                            @if (_currentRelease is not null) { <span>· @L["Devices.Latest", _currentRelease]</span> }
                            @if (device.Platform == DevicePlatform.Windows && _currentRelease is not null && IsOutdatedCurrent(device))
                            {
                                <span class="badge-soft warn">@L["Devices.UpdateAvailable"]</span>
                            }
                        </div>
                        <div class="muted tiny">
                            @L["Devices.TimeZone"]:
                            <select value="@device.TimeZoneId" @onchange="e => SetTimeZoneAsync(device, e.Value?.ToString())">
                                @foreach (var zone in TimeZones)
                                {
                                    <option value="@zone.Id">@zone.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="muted tiny">
                            @L["Devices.ClientLanguage"]:
                            <select value="@(_deviceLanguages.GetValueOrDefault(device.DeviceId) ?? "")" @onchange="e => SetLanguageAsync(device, e.Value?.ToString())">
                                <option value="">@L["Devices.FollowFamily", FamilyLanguageLabel]</option>
                                <option value="en">@L["Language.English"]</option>
                                <option value="es-MX">@L["Language.Spanish"]</option>
                            </select>
                        </div>
                        @if (_isOwner && _noticeSettings.TryGetValue(device.DeviceId, out var notice))
                        {
                            <div class="notice-settings">
                                <label class="check"><input type="checkbox" checked="@notice.Screen" @onchange="e => SaveNoticeAsync(device.DeviceId, (bool)(e.Value ?? false), notice.Camera, notice.Light)" /> @L["Devices.NoticeScreen"]</label>
                                <label class="check"><input type="checkbox" checked="@notice.Camera" @onchange="e => SaveNoticeAsync(device.DeviceId, notice.Screen, (bool)(e.Value ?? false), notice.Light)" /> @L["Devices.NoticeCamera"]</label>
                                <label class="check"><input type="checkbox" checked="@notice.Light" @onchange="e => SaveNoticeAsync(device.DeviceId, notice.Screen, !(bool)(e.Value ?? false), (bool)(e.Value ?? false))" /> @L["Devices.CameraLight"]</label>
                            </div>
                        }
                        @if (_updateStatuses.TryGetValue(device.DeviceId, out var updateStatus) && !string.IsNullOrWhiteSpace(updateStatus))
                        {
                            <div class="muted tiny">@L["Devices.UpdateStatus", UpdateStatusText(updateStatus)]</div>
                        }
                        @if (_canMessage)
                        {
                            <details class="inline-message">
                                <summary class="ghost-btn">@L["Devices.Message"]</summary>
                                <MessageComposer ChildId="device.ChildId" DeviceId="device.DeviceId" Compact="true" />
                            </details>
                        }
                    </div>
                    <div class="device-meta">
                        <div class="small">@(device.Online ? L["Common.Online"] : L["Common.Offline"])</div>
                        <div class="muted tiny">@(device.LastSeenUtc is { } seen ? Formats.CompactDateTime(seen.ToLocalTime()) : L["Common.Never"])</div>
                        @if (device.Platform == DevicePlatform.Windows && _currentRelease is not null && IsOutdatedCurrent(device))
                        {
                            <button type="button" class="ghost-btn" onclick="ocpRequestUpdate(this, '@device.DeviceId')">@L["Devices.UpdateNow"]</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Guid _familyId;
    private List<DeviceStatusDto> _devices = [];
    private string? _currentRelease;
    private string? _error;
    private Dictionary<Guid, string?> _updateStatuses = [];
    private Dictionary<Guid, NoticeSettings> _noticeSettings = new();
    private Dictionary<Guid, string?> _deviceLanguages = [];
    private string _familyLanguage = AppCulture.English;

    private string FamilyLanguageLabel => _familyLanguage == AppCulture.Spanish ? L["Language.Spanish"] : L["Language.English"];

    private string UpdateStatusText(string status)
    {
        var value = status.Split(' ')[0];
        var translated = L["UpdateStatus." + value];
        return translated.ResourceNotFound ? status : status.Replace(value, translated.Value);
    }

    private static string PlatformName(DevicePlatform platform) => platform switch
    {
        DevicePlatform.Windows => "Windows",
        DevicePlatform.Linux => "Linux",
        DevicePlatform.Android => "Android",
        _ => platform.ToString()
    };

    private async Task SetLanguageAsync(DeviceStatusDto device, string? language)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            await scope.ServiceProvider.GetRequiredService<LanguageService>()
                .SetDeviceLanguageAsync(_familyId, device.DeviceId, language);
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }
    private bool _isOwner;
    private bool _canMessage;
    private sealed record NoticeSettings(bool Screen, bool Camera, bool Light);
    private static readonly IReadOnlyList<TimeZoneInfo> TimeZones = TimeZoneInfo.GetSystemTimeZones();

    private async Task SetTimeZoneAsync(DeviceStatusDto device, string? zoneId)
    {
        if (string.IsNullOrWhiteSpace(zoneId)) return;
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var row = await db.Devices.FirstOrDefaultAsync(d => d.Id == device.DeviceId && d.FamilyId == _familyId);
            if (row is null) return;
            row.TimeZoneId = TimeZoneResolver.Resolve(zoneId).Id;
            await db.SaveChangesAsync();
            await RefreshAsync();
        }
        catch { }
    }

    private bool IsOutdatedCurrent(DeviceStatusDto device)
    {
        if (string.IsNullOrWhiteSpace(device.ClientVersion)) return true;
        if (_currentRelease is null) return false;
        return ReleaseCatalog.ParseVersion(device.ClientVersion) < ReleaseCatalog.ParseVersion(_currentRelease);
    }

    protected override async Task OnInitializedAsync()
    {
        _currentRelease = Releases.CurrentInfo()?.Version;
        var auth = await AuthState.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId);
        _isOwner = string.Equals(auth.User.FindFirst("family_role")?.Value, "Owner", StringComparison.OrdinalIgnoreCase);
        _canMessage = _isOwner || (int.TryParse(auth.User.FindFirst("permissions")?.Value, out var messagePermissions)
            && (messagePermissions & (int)OpControl.Parental.Contracts.ParentPermissions.Messaging) != 0);
        Events.DeviceStatusChanged += OnStatus;
        await RefreshAsync();
    }

    private void OnStatus(DeviceStatusDto status) => _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var devices = await db.Devices.AsNoTracking().Where(d => d.FamilyId == _familyId).OrderBy(d => d.Name).ToListAsync();
        var ids = devices.Select(d => d.Id).ToList();
        var accounts = await db.DeviceAccounts.AsNoTracking()
            .Where(a => ids.Contains(a.DeviceId))
            .GroupBy(a => a.DeviceId)
            .Select(g => new { DeviceId = g.Key, Account = g.Select(a => a.OsAccountName).FirstOrDefault() })
            .ToDictionaryAsync(x => x.DeviceId, x => x.Account);
        _devices = devices.Select(d => new DeviceStatusDto(d.Id, d.ChildId, d.Name, d.Platform, Presence.IsOnline(d.Id), d.LastSeenUtc, d.TimeZoneId, accounts.GetValueOrDefault(d.Id), d.ClientVersion)).ToList();
        _updateStatuses = devices.ToDictionary(d => d.Id, d => d.UpdateStatus is null ? null : $"{d.UpdateStatus} {d.UpdateTargetVersion}".Trim());
        _noticeSettings = devices.ToDictionary(d => d.Id, d => new NoticeSettings(d.ScreenNoticeEnabled, d.CameraNoticeEnabled, d.HasCameraLightOrShutter));
        _deviceLanguages = devices.ToDictionary(d => d.Id, d => d.ClientLanguage);
        _familyLanguage = AppCulture.Normalize(await db.Families.AsNoTracking().Where(f => f.Id == _familyId).Select(f => f.DefaultLanguage).FirstOrDefaultAsync());
    }

    private async Task SaveNoticeAsync(Guid deviceId, bool screen, bool camera, bool light)
    {
        try
        {
            await JS.InvokeAsync<bool>("ocpSaveDeviceNotice", deviceId, screen, camera, light);
            _error = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    public ValueTask DisposeAsync()
    {
        Events.DeviceStatusChanged -= OnStatus;
        return ValueTask.CompletedTask;
    }
}
