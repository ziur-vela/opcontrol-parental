@page "/downloads"
@attribute [Authorize(Policy = ParentalPolicies.ManageDevices)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Services
@inject ReleaseCatalog Releases
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Downloads.PageTitle"]</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">@L["Downloads.Eyebrow"]</div>
        <h1>@L["Nav.Downloads"]</h1>
        <p class="muted">@L["Downloads.Subtitle"]</p>
    </div>
</div>

@if (_current is null)
{
    <div class="card">
        <p class="muted">@L["Downloads.NoRelease"]</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-title-row">
            <h2>@L["Downloads.WindowsInstaller"]</h2>
            <span class="pill-soft">v@_current.Version</span>
        </div>
        <p class="muted">@L["Downloads.InstallerHelp"]</p>
        <div class="button-row">
            <a class="btn btn-primary" href="/downloads/setup">@L["Downloads.DownloadSetup", _current.SetupFileName]</a>
            <a class="ghost-btn" href="/downloads/msi">@L["Downloads.DownloadMsi"]</a>
        </div>
        <p class="muted tiny">@L["Downloads.Sha", _current.Sha256]</p>
        <p class="muted tiny">@L["Downloads.Published", Formats.DateTimeLocal(_current.PublishedUtc.ToLocalTime())]</p>
    </div>
}

<div class="card">
    <h2>@L["Downloads.Silent"]</h2>
    <p class="muted">@L["Downloads.SilentHelp"]</p>
    <pre class="code-block">msiexec /i OpControlParental.msi /qn SERVER=https://parental.opcontrol.net CODE=XXXXXXXXXX ACCOUNT=&lt;child-windows-account&gt;</pre>
    <p class="muted small">@L["Downloads.SilentNote"]</p>
</div>

@code {
    private ReleaseInfoDto? _current;

    protected override void OnInitialized() => _current = Releases.CurrentInfo();
}
