@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@using OpControl.Parental.Server.Components.Shared
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject DevicePresenceService Presence
@inject DashboardEventBus Events
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Home.PageTitle"]</PageTitle>

@if (_loading)
{
    <div class="card"><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
}
else if (_childId == Guid.Empty)
{
    <div class="card"><h1>@L["Common.NoChildYet"]</h1><p class="muted">@L["Home.NoChildBody"]</p></div>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">@_familyName</div>
            <h1>@L[Greeting], @(_parentName ?? L["Home.ParentFallback"])</h1>
            <p class="muted">@DateTime.Now.ToString("dddd, d MMMM", System.Globalization.CultureInfo.CurrentCulture) · @OnlineSummary</p>
        </div>
        <div class="button-row">
            <a class="btn btn-ghost" href="/screen-time">@L["Nav.ScreenTime"]</a>
            <a class="btn btn-ghost" href="/schedules">@L["Nav.Schedules"]</a>
            <a class="btn btn-ghost" href="/add-device">@L["Nav.AddDevice"]</a>
        </div>
    </div>

    <nav class="child-tabs" aria-label="@L["Home.ChildSections"]">
        <a class="chip active" href="/">@L["Home.Overview"]</a>
        <a class="chip" href="/screen-time">@L["Nav.ScreenTime"]</a>
        <a class="chip" href="/websites">@L["Nav.Websites"]</a>
        <a class="chip" href="/apps">@L["Nav.Apps"]</a>
        <a class="chip" href="/activity">@L["Nav.Activity"]</a>
        <a class="chip" href="/devices">@L["Nav.Devices"]</a>
    </nav>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert danger">@_error</div>
    }

    @if (_canView)
    {
    <section class="stat-grid">
        <a class="card stat-card" href="/screen-time">
            <div class="eyebrow">@L["Home.ScreenTimeToday"]</div>
            <div class="stat-value">@FormatDuration(_usedTodaySeconds)</div>
            <div class="muted tiny">@(_limitMinutes > 0 ? L["Home.OfLimit", _limitMinutes] : L["Home.NoDailyLimitSet"])</div>
        </a>
        <a class="card stat-card" href="/devices">
            <div class="eyebrow">@L["Home.DevicesOnline"]</div>
            <div class="stat-value">@OnlineOfTotal</div>
            <div class="muted tiny">@L["Home.OfflineCount", _devices.Count(d => !d.Online)]</div>
        </a>
        <a class="card stat-card" href="/websites">
            <div class="eyebrow">@L["Home.BlockedAttempts"]</div>
            <div class="stat-value">@_blockedAttempts</div>
            <div class="muted tiny">@DistinctSites</div>
        </a>
        <a class="card stat-card" href="/schedules">
            <div class="eyebrow">@L["Home.NextSchedule"]</div>
            <div class="stat-value">@NextScheduleTime</div>
            <div class="muted tiny">@NextScheduleLabel</div>
        </a>
    </section>
    }

    <div class="grid-2 home-grid">
        <section class="card child-card">
            <div class="child-head">
                <div class="avatar">@Initials(_childName)</div>
                <div class="child-id">
                    <div class="child-name">@_childName</div>
                    <div class="muted tiny">@DeviceSummary · @StatusText</div>
                </div>
                <div class="button-row">
                    <span class="pill-soft @(_isOnline ? "online-pill" : "")">@(_isOnline ? L["Common.Online"] : L["Common.Offline"])</span>
                    <span class="pill-soft">@(_state?.IsLocked == true ? L["Common.Locked"] : L["Common.Unlocked"])</span>
                </div>
            </div>

            @if (_canView)
            {
            <div class="screen-time-block">
                <div class="card-title-row">
                    <div class="eyebrow">@L["Nav.ScreenTime"]</div>
                    <div class="muted small">@FormatDuration(_usedTodaySeconds) / @(_limitMinutes > 0 ? L["Common.Minutes", _limitMinutes] : L["Home.NoLimit"])</div>
                </div>
                <div class="progress-track large">
                    <div class="progress-fill" style="width:@ScreenPercent()%"></div>
                </div>
                <div class="muted tiny">@RemainingText</div>
            </div>
            }

            <div class="lock-banner @(_state?.IsLocked == true ? "locked" : "unlocked")">
                <span>@StateHeadline</span>
                <span class="muted tiny">@ReasonText</span>
            </div>

            @if (_canMessage)
            {
                <details class="inline-message">
                    <summary class="ghost-btn">@L["Home.MessageChild"]</summary>
                    <MessageComposer ChildId="_childId" Compact="true" OnSent="RefreshAsync" />
                </details>
            }

            @if (_canLock)
            {
                <div class="button-row">
                    <button class="btn btn-primary" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Lock)">@L["Home.LockNow"]</button>
                    <button class="btn btn-accent" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Bonus, 15)">@L["Home.Bonus15"]</button>
                    <button class="btn btn-accent" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Bonus, 30)">@L["Home.Bonus30"]</button>
                    <button class="btn btn-ghost" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Unlock)">@L["Common.Unlock"]</button>
                    <a class="btn btn-ghost" href="/screen-time">@L["Home.OpenProfile"]</a>
                </div>
                <div class="muted tiny">@(_hasPin ? L["Home.PinIsSet"] : L["Home.PinNotSet"]) <a href="/pin">@(_hasPin ? L["Home.ChangePin"] : L["Home.SetPin"])</a></div>
            }
            else
            {
                <div class="muted tiny">@L["Home.NoLockPermission"]</div>
            }
        </section>

        <section class="card">
            <div class="card-title-row">
                <h2>@L["Home.TodaysAlerts"]</h2>
                <a class="ghost-btn" href="/alerts">@L["Home.ViewAll"]</a>
            </div>
            @if (_alerts.Count == 0)
            {
                <p class="muted">@L["Home.NoAlertsToday"]</p>
            }
            else
            {
                <div class="alert-list compact">
                    @foreach (var alert in _alerts)
                    {
                        <a class="alert-row" href="/alerts">
                            <div class="timeline-icon @Tone(alert.Type)">@Icon(alert.Type)</div>
                            <div class="timeline-main">
                                <div class="timeline-title">@AlertTitle(alert)</div>
                                <div class="muted tiny">@AlertDetail(alert)</div>
                            </div>
                            <div class="muted tiny">@FormatLocal(alert.CreatedUtc)</div>
                        </a>
                    }
                </div>
            }
            <div class="micro-stats">
                <div><div class="eyebrow">@L["Home.TopAppToday"]</div><div class="small">@(_topApps.FirstOrDefault()?.DisplayName ?? L["Home.NoUsageYet"])</div></div>
                <div><div class="eyebrow">@L["Home.AlwaysBlocked"]</div><div class="small">@AlwaysBlockedCounts</div></div>
            </div>
        </section>
    </div>

    <section class="card">
        <div class="card-title-row">
            <h2>@L["Home.TodaysSchedule"]</h2>
            <a class="ghost-btn" href="/schedules">@L["Home.AllSchedules"]</a>
        </div>
        <div class="schedule-bar">
            @foreach (var segment in _scheduleSegments)
            {
                <div class="schedule-segment" style="left:@segment.Left%;width:@segment.Width%" title="@segment.Label">@segment.Label</div>
            }
            <div class="schedule-now" style="left:@NowPercent()%"></div>
        </div>
        <div class="schedule-ticks">
            <span>@TickLabel(0)</span><span>@TickLabel(6)</span><span>@TickLabel(12)</span><span>@TickLabel(18)</span><span>@TickLabel(0)</span>
        </div>
    </section>

    <div class="grid-2">
        <section class="card">
            <div class="card-title-row">
                <h2>@L["Nav.Devices"]</h2>
                <span class="pill-soft">@_devices.Count</span>
            </div>
            @if (_devices.Count == 0)
            {
                <p class="muted">@L["Home.NoDevicesEnrolled"]</p>
            }
            else
            {
                <div class="device-list">
                    @foreach (var device in _devices)
                    {
                        <div class="device-row">
                            <span class="status-dot @(device.Online ? "online" : "offline")"></span>
                            <div class="device-main">
                                <div class="device-name">@device.Name</div>
                                <div class="muted tiny">@PlatformName(device.Platform) · @(device.OsAccountName ?? L["Common.AccountNotReported"]) · @(string.IsNullOrWhiteSpace(device.ClientVersion) ? L["Common.VersionUnknown"] : L["Home.ClientVersion", device.ClientVersion])</div>
                            </div>
                            <div class="device-meta">
                                <div class="small">@(device.Online ? L["Common.Online"] : L["Common.Offline"])</div>
                                <div class="muted tiny">@LastSeen(device.LastSeenUtc)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card">
            <div class="card-title-row">
                <h2>@L["Home.TopAppsToday"]</h2>
                <a class="ghost-btn" href="/screen-time">@L["Home.Report"]</a>
            </div>
            @if (_topApps.Count == 0)
            {
                <p class="muted">@L["Home.NoUsageToday"]</p>
            }
            else
            {
                <div class="usage-bars">
                    @foreach (var app in _topApps)
                    {
                        <div class="usage-row">
                            <div class="usage-main">
                                <div class="usage-title">@app.DisplayName <span class="muted tiny">@FormatDuration(app.Seconds)</span></div>
                                <div class="usage-track"><div class="usage-fill" style="width:@TopAppPercent(app.Seconds)%"></div></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    </div>
}

@code {
    private sealed record AppRow(string DisplayName, int Seconds);
    private sealed record Segment(double Left, double Width, string Label);

    private Guid _familyId;
    private Guid _childId;
    private string _familyName = "";
    private string _childName = "";
    private string? _parentName;
    private LockStateDto? _state;
    private List<DeviceStatusDto> _devices = [];
    private List<Alert> _alerts = [];
    private List<AppRow> _topApps = [];
    private List<ScheduleDto> _schedules = [];
    private List<Segment> _scheduleSegments = [];
    private bool _loading = true;
    private bool _canLock;
    private bool _canView;
    private bool _canMessage;
    private bool _busy;
    private bool _hasPin;
    private int _usedTodaySeconds;
    private int _limitMinutes;
    private int _blockedAttempts;
    private int _blockedDomains;
    private int _sitesBlockedCount;
    private int _appsBlockedCount;
    private int _categoriesEnabled;
    private string _timeZoneId = "UTC";
    private string? _error;
    private Timer? _timer;
    private int _ticks;

    private bool _isOnline => _devices.Any(d => d.Online);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
        {
            _loading = false;
            _error = L["Home.MissingFamilyScope"];
            return;
        }
        var isOwner = string.Equals(auth.User.FindFirst("family_role")?.Value, "Owner", StringComparison.OrdinalIgnoreCase);
        _canLock = isOwner || (int.TryParse(auth.User.FindFirst("permissions")?.Value, out var permissions)
            && (permissions & (int)OpControl.Parental.Contracts.ParentPermissions.LockUnlockBonus) != 0);
        _canView = isOwner || (int.TryParse(auth.User.FindFirst("permissions")?.Value, out var reportPermissions)
            && (reportPermissions & (int)OpControl.Parental.Contracts.ParentPermissions.ViewReports) != 0);
        _canMessage = isOwner || (int.TryParse(auth.User.FindFirst("permissions")?.Value, out var messagePermissions)
            && (messagePermissions & (int)OpControl.Parental.Contracts.ParentPermissions.Messaging) != 0);

        Events.DeviceStatusChanged += OnDeviceStatus;
        Events.LockStateChanged += OnLockState;
        _timer = new Timer(_ => _ = TickAsync(), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        await RefreshAsync();
        _loading = false;
    }

    private void OnDeviceStatus(DeviceStatusDto status) =>
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private void OnLockState(LockStateDto state) =>
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private async Task TickAsync()
    {
        _ticks++;
        var expired = _state?.EndsUtc is { } ends && ends <= DateTime.UtcNow && !_state.IsLocked;
        if (expired || _ticks % 15 == 0)
            await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        else
            await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var family = await db.Families.AsNoTracking().FirstOrDefaultAsync(f => f.Id == _familyId);
        var child = await db.Children.AsNoTracking()
            .Where(c => c.FamilyId == _familyId)
            .OrderBy(c => c.CreatedUtc)
            .FirstOrDefaultAsync();
        if (child is null)
        {
            _childId = Guid.Empty;
            _familyName = family?.Name ?? "";
            return;
        }

        _childId = child.Id;
        _childName = child.Name;
        _familyName = family?.Name ?? "";
        _parentName = await db.Users.AsNoTracking()
            .Where(u => u.FamilyId == _familyId)
            .OrderBy(u => u.RoleInFamily == FamilyRole.Owner ? 0 : 1)
            .Select(u => u.DisplayName)
            .FirstOrDefaultAsync();

        var locks = scope.ServiceProvider.GetRequiredService<LockService>();
        var usage = scope.ServiceProvider.GetRequiredService<UsageService>();
        _state = await locks.GetStateAsync(_familyId, _childId, null);
        _hasPin = await locks.HasPinAsync(_familyId, _childId);

        _timeZoneId = await db.Devices.AsNoTracking().Where(d => d.ChildId == _childId).Select(d => d.TimeZoneId).FirstOrDefaultAsync() ?? "UTC";
        var tz = TimeZoneResolver.Resolve(_timeZoneId);
        var now = DateTime.UtcNow;
        var daily = await usage.BuildDailyLimitAsync(_familyId, _childId, tz, now);
        _usedTodaySeconds = daily.UsedTodaySeconds;
        _limitMinutes = daily.Enabled ? daily.TodayMinutes : 0;

        var (dayStart, dayEnd) = UsageService.LocalDayBounds(tz, now);
        _blockedAttempts = await db.VisitRecords.AsNoTracking()
            .CountAsync(v => v.FamilyId == _familyId && v.ChildId == _childId && v.Blocked && v.VisitedUtc >= dayStart && v.VisitedUtc < dayEnd);
        _blockedDomains = await db.VisitRecords.AsNoTracking()
            .Where(v => v.FamilyId == _familyId && v.ChildId == _childId && v.Blocked && v.VisitedUtc >= dayStart && v.VisitedUtc < dayEnd)
            .Select(v => v.Domain).Distinct().CountAsync();

        _sitesBlockedCount = await db.WebsiteRules.AsNoTracking().CountAsync(r => r.FamilyId == _familyId && r.ChildId == _childId && r.IsBlocked && r.Mode == RuleMode.Always);
        _appsBlockedCount = await db.AppRules.AsNoTracking().CountAsync(r => r.FamilyId == _familyId && r.ChildId == _childId && r.IsBlocked && r.Mode == RuleMode.Always);
        _categoriesEnabled = await db.ChildCategories.AsNoTracking().CountAsync(c => c.FamilyId == _familyId && c.ChildId == _childId && c.Enabled);

        var intervals = await db.UsageIntervals.AsNoTracking()
            .Where(u => u.FamilyId == _familyId && u.ChildId == _childId && u.Active && u.StartUtc >= dayStart && u.StartUtc < dayEnd && u.AppIdentity != "")
            .Select(u => new { u.AppIdentity, u.AppDisplayName, u.DurationSeconds })
            .ToListAsync();
        _topApps = intervals.GroupBy(i => i.AppIdentity, StringComparer.OrdinalIgnoreCase)
            .Select(g => new AppRow(
                g.Select(i => i.AppDisplayName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? g.Key,
                g.Sum(i => i.DurationSeconds)))
            .OrderByDescending(a => a.Seconds)
            .Take(4)
            .ToList();

        _schedules = await db.Schedules.AsNoTracking()
            .Where(s => s.FamilyId == _familyId && s.ChildId == _childId)
            .OrderBy(s => s.StartMinutes)
            .Select(s => new ScheduleDto(s.Id, s.Name, s.DaysMask, s.StartMinutes, s.EndMinutes, s.IsEnabled))
            .ToListAsync();
        BuildScheduleSegments(tz, now);

        var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
        _alerts = await alerts.GetAlertsAsync(_familyId, _childId, 5);

        var devices = await db.Devices.AsNoTracking()
            .Where(d => d.FamilyId == _familyId && d.ChildId == _childId)
            .OrderBy(d => d.Name)
            .ToListAsync();
        var deviceIds = devices.Select(d => d.Id).ToList();
        var accounts = await db.DeviceAccounts.AsNoTracking()
            .Where(a => deviceIds.Contains(a.DeviceId))
            .GroupBy(a => a.DeviceId)
            .Select(g => new { DeviceId = g.Key, Account = g.Select(a => a.OsAccountName).FirstOrDefault() })
            .ToDictionaryAsync(x => x.DeviceId, x => x.Account);
        _devices = devices.Select(d => new DeviceStatusDto(
            d.Id, d.ChildId, d.Name, d.Platform,
            Presence.IsOnline(d.Id), d.LastSeenUtc, d.TimeZoneId,
            accounts.GetValueOrDefault(d.Id), d.ClientVersion)).ToList();
    }

    private void BuildScheduleSegments(TimeZoneInfo tz, DateTime nowUtc)
    {
        _scheduleSegments = [];
        var local = TimeZoneInfo.ConvertTimeFromUtc(nowUtc, tz);
        var day = (int)local.DayOfWeek;
        var previous = (day + 6) % 7;
        foreach (var schedule in _schedules.Where(s => s.IsEnabled))
        {
            if (schedule.StartMinutes <= schedule.EndMinutes)
            {
                if ((schedule.DaysMask & (1 << day)) == 0) continue;
                _scheduleSegments.Add(new Segment(schedule.StartMinutes / 14.4, (schedule.EndMinutes - schedule.StartMinutes) / 14.4, schedule.Name));
            }
            else
            {
                if ((schedule.DaysMask & (1 << previous)) != 0)
                    _scheduleSegments.Add(new Segment(0, schedule.EndMinutes / 14.4, schedule.Name));
                if ((schedule.DaysMask & (1 << day)) != 0)
                    _scheduleSegments.Add(new Segment(schedule.StartMinutes / 14.4, (1440 - schedule.StartMinutes) / 14.4, schedule.Name));
            }
        }
    }

    private async Task ApplyAsync(LockAction action, int? minutes = null)
    {
        _busy = true;
        _error = null;
        try
        {
            using var scope = Scopes.CreateScope();
            var locks = scope.ServiceProvider.GetRequiredService<LockService>();
            var auth = await AuthState.GetAuthenticationStateAsync();
            var parentId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : (Guid?)null;
            _state = await locks.ApplyAsync(_familyId, _childId, parentId, action, minutes);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string Greeting => DateTime.Now.Hour switch
    {
        < 12 => "Home.GoodMorning",
        < 18 => "Home.GoodAfternoon",
        _ => "Home.GoodEvening"
    };

    private string DeviceSummary => _devices.Count switch
    {
        0 => L["Home.NoDevices"],
        1 => _devices[0].Name,
        _ => L["Common.DeviceCountPlural", _devices.Count]
    };

    private string StatusText => _state?.Reason switch
    {
        "schedule" => L["Home.StatusSchedule", _state.ScheduleName ?? ""],
        "daily-limit" => L["Home.StatusDailyLimit"],
        "manual" => L["Home.StatusManual"],
        "bonus" => L["Home.StatusBonus"],
        "override" => L["Home.StatusOverride"],
        _ => L["Home.StatusRules"]
    };

    private string StateHeadline => _state?.IsLocked == true
        ? L["Common.Locked"]
        : _state?.Reason == "bonus" ? L["Home.BonusActive"] : L["Common.Unlocked"];

    private string ReasonText => _state?.Reason switch
    {
        "bonus" => L["Home.ReasonBonus"],
        "override" => L["Home.ReasonOverride"],
        "manual" => L["Home.ReasonManual", _parentName ?? L["Home.AParent"]],
        "schedule" => L["Home.ReasonSchedule", string.IsNullOrWhiteSpace(_state.ScheduleName) ? L["Home.ASchedule"] : _state.ScheduleName],
        "daily-limit" => L["Home.ReasonDailyLimit"],
        _ => L["Home.ReasonNone"]
    };

    private string RemainingText
    {
        get
        {
            if (_limitMinutes <= 0) return L["Home.NoDailyLimitSet"];
            var remaining = Math.Max(0, _limitMinutes * 60 - _usedTodaySeconds);
            return remaining == 0 ? L["Home.LimitReachedUntilMidnight"] : L["Home.TimeLeftToday", FormatDuration(remaining)];
        }
    }

    private string NextScheduleTime
    {
        get
        {
            var active = LockRules.ActiveSchedule(_schedules, TimeZoneResolver.Resolve(_timeZoneId), DateTime.UtcNow);
            var next = LockRules.NextScheduleStart(_schedules, TimeZoneResolver.Resolve(_timeZoneId), DateTime.UtcNow);
            if (active is not null) return FormatTimeLocal(LockRules.CurrentScheduleEnd(active, TimeZoneResolver.Resolve(_timeZoneId), DateTime.UtcNow));
            return next is { } value ? FormatTimeLocal(value) : L["Common.None"];
        }
    }

    private string NextScheduleLabel
    {
        get
        {
            var active = LockRules.ActiveSchedule(_schedules, TimeZoneResolver.Resolve(_timeZoneId), DateTime.UtcNow);
            if (active is not null) return L["Home.ScheduleUntil", active.Name];
            var next = LockRules.NextScheduleStart(_schedules, TimeZoneResolver.Resolve(_timeZoneId), DateTime.UtcNow);
            return next is null ? L["Home.NoScheduleSet"] : L["Home.NextLock"];
        }
    }

    private int ScreenPercent() => _limitMinutes <= 0 ? 0 : Math.Clamp((int)(_usedTodaySeconds * 100.0 / (_limitMinutes * 60)), 0, 100);
    private int TopAppPercent(int seconds) { var max = _topApps.Count == 0 ? 0 : _topApps.Max(a => a.Seconds); return max <= 0 ? 0 : Math.Max(2, (int)(seconds * 100.0 / max)); }
    private double NowPercent() => DateTime.Now.TimeOfDay.TotalMinutes / 14.4;
    private static string Initials(string name) => name.Length == 0 ? "?" : name[..1].ToUpperInvariant();

    private string FormatLocal(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneResolver.Resolve(_timeZoneId)).ToString("t", System.Globalization.CultureInfo.CurrentCulture);

    private string FormatTimeLocal(DateTime? utc) =>
        utc is { } value ? TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(value, DateTimeKind.Utc), TimeZoneResolver.Resolve(_timeZoneId)).ToString("t", System.Globalization.CultureInfo.CurrentCulture) : "—";

    private static string FormatDuration(int seconds) => Formats.Duration(seconds);

    private string LastSeen(DateTime? utc) => utc is null ? L["Common.Never"] : Formats.CompactDateTime(utc.Value.ToLocalTime());

    private string TickLabel(int hour) => DateTime.Today.AddHours(hour).ToString("h tt", System.Globalization.CultureInfo.CurrentCulture);

    private string OnlineOfTotal => L["Home.OnlineOfShort", _devices.Count(d => d.Online), _devices.Count];

    private string OnlineSummary =>
        L["Home.OnlineOf", _devices.Count(d => d.Online), L[_devices.Count == 1 ? "Common.DeviceCount" : "Common.DeviceCountPlural", _devices.Count]];

    private string DistinctSites =>
        L[_blockedDomains == 1 ? "Home.DistinctSiteOne" : "Home.DistinctSiteMany", _blockedDomains];

    private string AlwaysBlockedCounts =>
        $"{L[_sitesBlockedCount == 1 ? "Common.SiteCount" : "Common.SiteCountPlural", _sitesBlockedCount]} · " +
        $"{L[_appsBlockedCount == 1 ? "Common.AppCount" : "Common.AppCountPlural", _appsBlockedCount]} · " +
        $"{L[_categoriesEnabled == 1 ? "Common.CategoryCount" : "Common.CategoryCountPlural", _categoriesEnabled]}";

    private static string PlatformName(DevicePlatform platform) => platform switch
    {
        DevicePlatform.Windows => "Windows",
        DevicePlatform.Linux => "Linux",
        DevicePlatform.Android => "Android",
        _ => platform.ToString()
    };

    private string AlertTitle(Alert alert) => AlertText.Render(alert).Title;
    private string AlertDetail(Alert alert) => AlertText.Render(alert).Detail;

    private static string Icon(string type) => type switch
    {
        "new-app" => "＋", "repeated-blocked-site" => "⊘", "pin-override" => "✦",
        "daily-limit" or "app-limit" => "◔", "device-offline" => "⇄", "tampering" => "!", "child-message" => "✉", _ => "◉"
    };

    private static string Tone(string type) => type switch
    {
        "repeated-blocked-site" or "daily-limit" or "app-limit" => "danger",
        "device-offline" or "tampering" => "warn",
        "child-message" => "accent",
        _ => "accent"
    };

    public ValueTask DisposeAsync()
    {
        Events.DeviceStatusChanged -= OnDeviceStatus;
        Events.LockStateChanged -= OnLockState;
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
