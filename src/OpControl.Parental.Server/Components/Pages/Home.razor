@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject DevicePresenceService Presence
@inject DashboardEventBus Events

<PageTitle>Home · Parental OpControl</PageTitle>

@if (_loading)
{
    <div class="card"><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
}
else if (_childId == Guid.Empty)
{
    <div class="card"><h1>No child yet</h1><p class="muted">Create a child profile to start managing devices.</p></div>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">@_familyName</div>
            <h1>@_childName</h1>
            <p class="muted">Lock state applies to every device assigned to this child.</p>
        </div>
        <div class="button-row">
            <a class="btn btn-ghost" href="/schedules">Schedules</a>
            <a class="btn btn-ghost" href="/add-device">Add device</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert danger">@_error</div>
    }

    <section class="quick-grid">
        <a class="card quick-card" href="/websites">
            <div class="eyebrow">Sites blocked today</div>
            <div class="quick-number">@_sitesBlockedToday</div>
            <div class="muted tiny">Blocked attempts recorded on @_childName's devices today.</div>
            <span class="quick-link">Open websites →</span>
        </a>
        <a class="card quick-card" href="/apps">
            <div class="eyebrow">New apps to review</div>
            <div class="quick-number">@_newAppsCount</div>
            <div class="muted tiny">Installed since the last review across @_childName's devices.</div>
            <span class="quick-link">Review apps →</span>
        </a>
    </section>

    <section class="grid-2">
        <div class="card hero-card">
            <div class="hero-top">
                <div class="shield">🛡</div>
                <div>
                    <div class="eyebrow">Device lock</div>
                    <div class="lock-status @(_state?.IsLocked == true ? "locked" : "unlocked")">@StateHeadline</div>
                    <div class="muted small">@ReasonText</div>
                    @if (EndsText is not null)
                    {
                        <div class="muted tiny">@EndsText</div>
                    }
                </div>
            </div>
            @if (CountdownText is not null)
            {
                <div class="countdown">@CountdownText</div>
            }
            <div class="button-row">
                <button class="btn btn-danger" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Lock)">Lock</button>
                <button class="btn btn-primary" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Unlock)">Unlock (until next cycle)</button>
            </div>
            <div class="bonus-row">
                <span class="muted small">Bonus</span>
                <button class="btn btn-accent" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Bonus, 15)">15 min</button>
                <button class="btn btn-accent" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Bonus, 30)">30 min</button>
                <button class="btn btn-accent" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Bonus, 60)">60 min</button>
                <input type="number" min="1" max="1440" @bind="_customBonus" class="mini-input" />
                <button class="btn btn-ghost" disabled="@_busy" @onclick="() => ApplyAsync(LockAction.Bonus, _customBonus)">Custom</button>
            </div>
            <div class="button-row">
                <a class="btn btn-ghost" href="/pin">@(_hasPin ? "Change override PIN" : "Set override PIN")</a>
            </div>
            <div class="muted tiny">Server time @DateTime.UtcNow.ToString("u")</div>
        </div>

        <div class="card">
            <div class="card-title-row">
                <h2>Devices</h2>
                <span class="pill-soft">@_devices.Count(d => d.Online) online</span>
            </div>
            @if (_devices.Count == 0)
            {
                <p class="muted">No devices enrolled yet.</p>
            }
            else
            {
                <div class="device-list">
                    @foreach (var device in _devices)
                    {
                        <div class="device-row">
                            <span class="status-dot @(device.Online ? "online" : "offline")"></span>
                            <div class="device-main">
                                <div class="device-name">@device.Name</div>
                                <div class="muted tiny">@device.Platform · @(device.TimeZoneId ?? "UTC") · @(device.OsAccountName ?? "account not reported")</div>
                                <div class="muted tiny">@(string.IsNullOrWhiteSpace(device.ClientVersion) ? "version unknown" : "client " + device.ClientVersion)</div>
                            </div>
                            <div class="device-meta">
                                <div class="small">@(device.Online ? "Online" : "Offline")</div>
                                <div class="muted tiny">@LastSeen(device.LastSeenUtc)</div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="card">
        <div class="card-title-row">
            <h2>Activity history</h2>
            <span class="pill-soft">Latest 15</span>
        </div>
        @if (_history.Count == 0 && _blockHistory.Count == 0)
        {
            <p class="muted">No activity recorded yet.</p>
        }
        else
        {
            <div class="history-list">
                @foreach (var item in _activity)
                {
                    <div class="history-row">
                        <div>
                            <div class="small">@item.Label</div>
                            <div class="muted tiny">@item.When.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        </div>
                        <div class="muted small">@item.Detail</div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private Guid _familyId;
    private Guid _childId;
    private string _familyName = "";
    private string _childName = "";
    private string? _parentName;
    private LockStateDto? _state;
    private List<DeviceStatusDto> _devices = [];
    private List<OverrideEventDto> _history = [];
    private List<BlockEventDto> _blockHistory = [];
    private List<ActivityRow> _activity = [];
    private sealed record ActivityRow(string Label, DateTime When, string Detail);
    private bool _loading = true;
    private bool _busy;
    private bool _hasPin;
    private int _sitesBlockedToday;
    private int _newAppsCount;
    private int _customBonus = 20;
    private string? _error;
    private Timer? _timer;
    private int _ticks;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
        {
            _loading = false;
            _error = "Family scope is missing from the session.";
            return;
        }

        Events.DeviceStatusChanged += OnDeviceStatus;
        Events.LockStateChanged += OnLockState;
        _timer = new Timer(_ => _ = TickAsync(), null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
        await RefreshAsync();
        _loading = false;
    }

    private void OnDeviceStatus(DeviceStatusDto status) =>
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private void OnLockState(LockStateDto state) =>
        _ = InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });

    private async Task TickAsync()
    {
        _ticks++;
        var expired = _state?.EndsUtc is { } ends && ends <= DateTime.UtcNow && !_state.IsLocked;
        if (expired || _ticks % 15 == 0)
            await InvokeAsync(async () => { await RefreshAsync(); StateHasChanged(); });
        else
            await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var family = await db.Families.AsNoTracking().FirstOrDefaultAsync(f => f.Id == _familyId);
        var child = await db.Children.AsNoTracking()
            .Where(c => c.FamilyId == _familyId)
            .OrderBy(c => c.CreatedUtc)
            .FirstOrDefaultAsync();
        if (child is null)
        {
            _childId = Guid.Empty;
            _familyName = family?.Name ?? "";
            return;
        }

        _childId = child.Id;
        _childName = child.Name;
        _familyName = family?.Name ?? "";
        _parentName = await db.Users.AsNoTracking()
            .Where(u => u.FamilyId == _familyId)
            .OrderBy(u => u.RoleInFamily == OpControl.Parental.Contracts.FamilyRole.Owner ? 0 : 1)
            .Select(u => u.DisplayName)
            .FirstOrDefaultAsync();

        var locks = scope.ServiceProvider.GetRequiredService<LockService>();
        _state = await locks.GetStateAsync(_familyId, _childId, null);
        _hasPin = await locks.HasPinAsync(_familyId, _childId);

        var tzId = await db.Devices.AsNoTracking().Where(d => d.ChildId == _childId).Select(d => d.TimeZoneId).FirstOrDefaultAsync() ?? "UTC";
        var tz = TimeZoneResolver.Resolve(tzId);
        var localToday = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, tz).Date;
        var dayStart = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(localToday, DateTimeKind.Unspecified), tz);
        var dayEnd = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(localToday.AddDays(1), DateTimeKind.Unspecified), tz);
        _sitesBlockedToday = await db.VisitRecords.AsNoTracking()
            .Where(v => v.FamilyId == _familyId && v.ChildId == _childId && v.Blocked && v.VisitedUtc >= dayStart && v.VisitedUtc < dayEnd)
            .Select(v => v.Domain)
            .Distinct()
            .CountAsync();
        _newAppsCount = await db.InstalledApps.AsNoTracking()
            .Where(a => a.FamilyId == _familyId && a.ChildId == _childId && a.IsNew && a.ReviewedUtc == null && a.RemovedUtc == null)
            .Select(a => a.Identity)
            .Distinct()
            .CountAsync();

        _history = await locks.GetHistoryAsync(_familyId, _childId);
        _blockHistory = await db.BlockEvents.AsNoTracking()
            .Where(b => b.FamilyId == _familyId && b.ChildId == _childId)
            .OrderByDescending(b => b.OccurredUtc)
            .Take(15)
            .Select(b => new BlockEventDto(b.RuleType, b.Identity, b.DisplayName, b.OccurredUtc))
            .ToListAsync();
        _activity = _history.Select(h => new ActivityRow(HistoryLabel(h.Option, h.Detail), h.CreatedUtc, h.Minutes is null ? "" : $"{h.Minutes} min"))
            .Concat(_blockHistory.Select(b => new ActivityRow(b.RuleType == "site" ? "Website blocked" : "App blocked", b.OccurredUtc, b.DisplayName)))
            .OrderByDescending(a => a.When)
            .Take(15)
            .ToList();

        var devices = await db.Devices.AsNoTracking()
            .Where(d => d.FamilyId == _familyId && d.ChildId == _childId)
            .OrderBy(d => d.Name)
            .ToListAsync();
        var deviceIds = devices.Select(d => d.Id).ToList();
        var accounts = await db.DeviceAccounts.AsNoTracking()
            .Where(a => deviceIds.Contains(a.DeviceId))
            .GroupBy(a => a.DeviceId)
            .Select(g => new { DeviceId = g.Key, Account = g.Select(a => a.OsAccountName).FirstOrDefault() })
            .ToDictionaryAsync(x => x.DeviceId, x => x.Account);
        _devices = devices.Select(d => new DeviceStatusDto(
            d.Id, d.ChildId, d.Name, d.Platform,
            Presence.IsOnline(d.Id), d.LastSeenUtc, d.TimeZoneId,
            accounts.GetValueOrDefault(d.Id), d.ClientVersion)).ToList();
    }

    private async Task ApplyAsync(LockAction action, int? minutes = null)
    {
        _busy = true;
        _error = null;
        try
        {
            using var scope = Scopes.CreateScope();
            var locks = scope.ServiceProvider.GetRequiredService<LockService>();
            var auth = await AuthState.GetAuthenticationStateAsync();
            var parentId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : (Guid?)null;
            _state = await locks.ApplyAsync(_familyId, _childId, parentId, action, minutes);
            await RefreshAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private string StateHeadline => _state?.IsLocked == true
        ? "Locked"
        : _state?.Reason == "bonus" ? "Bonus time" : "Unlocked";

    private string ReasonText => _state?.Reason switch
    {
        "bonus" => "Bonus time is active.",
        "override" => "Unlocked until the next lock cycle.",
        "manual" => $"Locked by {_parentName ?? "a parent"}.",
        "schedule" => $"Locked by {(string.IsNullOrWhiteSpace(_state.ScheduleName) ? "a schedule" : _state.ScheduleName)}.",
        _ => "No lock is active."
    };

    private string? EndsText => _state?.EndsUtc is { } ends
        ? (_state.IsLocked ? $"Unlocks {FormatUtc(ends)}" : $"Until {FormatUtc(ends)}")
        : null;

    private string? CountdownText
    {
        get
        {
            var now = DateTime.UtcNow;
            if (_state?.BonusUntilUtc is { } bonus && bonus > now)
                return $"Bonus {Format(bonus - now)} left";
            if (_state?.UnlockUntilUtc is { } unlock && unlock > now)
                return $"Unlock ends in {Format(unlock - now)}";
            return null;
        }
    }

    private static string Format(TimeSpan span) => $"{(int)span.TotalHours:00}:{span.Minutes:00}:{span.Seconds:00}";
    private static string FormatUtc(DateTime utc) => utc.ToLocalTime().ToString("MMM d, HH:mm");
    private static string LastSeen(DateTime? utc) => utc is null ? "never" : utc.Value.ToLocalTime().ToString("MMM d, HH:mm");

    private static string HistoryLabel(string option, string? detail = null) => option switch
    {
        "dashboard-unlock" => "Dashboard unlock",
        "dashboard-bonus" => "Dashboard bonus",
        "pin-unlock-until-next" => "PIN override: unlock until next cycle",
        "pin-bonus" => "PIN override: bonus time",
        "schedule-start" => $"Schedule started: {detail}",
        "schedule-end" => $"Schedule ended: {detail}",
        "item-bonus-site" => $"Website bonus: {detail}",
        "item-bonus-app" => $"App bonus: {detail}",
        _ => option
    };

    public ValueTask DisposeAsync()
    {
        Events.DeviceStatusChanged -= OnDeviceStatus;
        Events.LockStateChanged -= OnLockState;
        _timer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
