@page "/server-admin"
@attribute [Authorize(Policy = ParentalPolicies.ServerAdmin)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject BuildInfo Build
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["ServerAdmin.PageTitle"]</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">@L["ServerAdmin.Eyebrow"]</div>
        <h1>@L["Nav.ServerAdmin"]</h1>
        <p class="muted">@L["ServerAdmin.Subtitle"]</p>
    </div>
    <span class="pill-soft">@Build.DisplayVersion</span>
</div>

@if (!_isServerAdmin)
{
    <div class="card danger"><h2>@L["ServerAdmin.NotAllowed"]</h2><p class="muted">@L["ServerAdmin.NotAllowedBody"]</p></div>
}
else
{
    @if (_error is not null) { <div class="alert danger">@_error</div> }
    @if (_notice is not null) { <div class="alert ok">@_notice</div> }

    <section class="card">
        <h2>@L["ServerAdmin.EmailPreview"]</h2>
        <p class="muted small">@L["ServerAdmin.EmailPreviewHelp"]</p>
        <a class="btn btn-primary" href="/server-admin/email-preview">@L["ServerAdmin.OpenEmailPreview"]</a>
    </section>

    <section class="card">
        <h2>@L["ServerAdmin.InviteFamily"]</h2>
        <p class="muted small">@L["ServerAdmin.InviteHelp"]</p>
        <div class="grid-2">
            <label class="field"><span>@L["Team.EmailOptional"]</span><input @bind="_inviteEmail" placeholder="owner@example.com" /></label>
            <label class="field"><span>@L["ServerAdmin.FamilyHint"]</span><input @bind="_inviteFamilyName" /></label>
        </div>
        <div class="button-row">
            <button class="btn btn-primary" @onclick="InviteAsync">@L["Team.CreateInvitation"]</button>
        </div>
        @if (_createdLink is not null)
        {
            <label class="field"><span>@L["ServerAdmin.OneTimeInviteLink"]</span><input readonly value="@_createdLink" /></label>
            <div class="muted tiny">@(_emailSent ? L["ServerAdmin.EmailSent"] : L["ServerAdmin.CopyLink"])</div>
        }
    </section>

    <section class="card">
        <h2>@L["ServerAdmin.PendingFamilies"]</h2>
        @if (_invitations.Count == 0)
        {
            <p class="muted">@L["ServerAdmin.NoPending"]</p>
        }
        else
        {
            <div class="device-list">
                @foreach (var invite in _invitations)
                {
                    <div class="device-row">
                        <div class="device-main">
                            <div class="device-name">@(invite.Email ?? L["Team.LinkOnly"])</div>
                            <div class="muted tiny">@(invite.FamilyName ?? L["ServerAdmin.FamilyNameChosen"]) · @L["Team.Expires", Formats.CompactDateTime(invite.ExpiresUtc.ToLocalTime())]</div>
                        </div>
                        <div class="device-meta">
                            <button class="ghost-btn" @onclick="() => ResendAsync(invite)">@L["Team.Resend"]</button>
                            <button class="ghost-btn" @onclick="() => RevokeAsync(invite)">@L["Team.Revoke"]</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <section class="card">
        <h2>@L["ServerAdmin.Families"]</h2>
        <div class="device-list">
            @foreach (var family in _families)
            {
                <div class="device-row">
                    <div class="device-main">
                        <div class="device-name">@family.Name @(family.Status == FamilyStatus.Suspended ? L["ServerAdmin.Suspended"] : "")</div>
                        <div class="muted tiny">@family.OwnerName · @family.OwnerEmail · @L["ServerAdmin.Created", family.CreatedUtc.ToLocalTime().ToString("d MMM yyyy", System.Globalization.CultureInfo.CurrentCulture)]</div>
                        <div class="muted tiny">@L["ServerAdmin.FamilyCounts", family.Children, family.Devices] · @L["ServerAdmin.LastActivity", family.LastActivityUtc is { } last ? Formats.CompactDateTime(last.ToLocalTime()) : L["Common.Never"]]</div>
                    </div>
                    <div class="device-meta">
                        @if (family.Status == FamilyStatus.Active)
                        {
                            <button class="ghost-btn" @onclick="() => SetStatusAsync(family, false)">@L["ServerAdmin.Suspend"]</button>
                        }
                        else
                        {
                            <button class="ghost-btn" @onclick="() => SetStatusAsync(family, true)">@L["ServerAdmin.Reactivate"]</button>
                        }
                        <button class="ghost-btn danger-text" @onclick="() => BeginDelete(family)">@L["Common.Delete"]</button>
                    </div>
                </div>
            }
        </div>
        @if (_deleting is not null)
        {
            <div class="alert danger">
                <div>@L["ServerAdmin.DeleteConfirm1"] <strong>@_deleting.Name</strong> @L["ServerAdmin.DeleteConfirm2"]</div>
                <label class="field"><span>@L["ServerAdmin.TypeName"]</span><input @bind="_deleteConfirmation" /></label>
                <div class="button-row">
                    <button class="btn btn-primary" disabled="@(_deleteConfirmation != _deleting.Name)" @onclick="DeleteAsync">@L["ServerAdmin.DeleteFamily"]</button>
                    <button class="btn btn-ghost" @onclick="CancelDelete">@L["Common.Cancel"]</button>
                </div>
            </div>
        }
    </section>

    <section class="card">
        <h2>@L["ServerAdmin.ServerSmtp"]</h2>
        <p class="muted small">@L["ServerAdmin.SmtpHelp"]</p>
        <div class="grid-2">
            <label class="field"><span>@L["Settings.SmtpHost"]</span><input @bind="_smtpHost" /></label>
            <label class="field"><span>@L["ServerAdmin.Port"]</span><input type="number" @bind="_smtpPort" /></label>
            <label class="field"><span>@L["ServerAdmin.Username"]</span><input @bind="_smtpUsername" /></label>
            <label class="field"><span>@L["Settings.SmtpPassword"] @(_hasSmtpPassword ? L["Settings.Stored"] : "")</span><input type="password" @bind="_smtpPassword" placeholder="@(_hasSmtpPassword ? L["Settings.LeaveBlankToKeep"] : "")" /></label>
            <label class="field"><span>@L["Settings.FromAddress"]</span><input @bind="_smtpFrom" /></label>
            <label class="field"><span>@L["ServerAdmin.FromName"]</span><input @bind="_smtpFromName" /></label>
        </div>
        <label class="check"><input type="checkbox" @bind="_smtpSsl" /> @L["Settings.UseSsl"]</label>
        <div class="button-row">
            <button class="btn btn-primary" @onclick="SaveSmtpAsync">@L["ServerAdmin.SaveSmtp"]</button>
            <button class="btn btn-ghost" @onclick="SendTestEmailAsync">@L["Settings.SendTestEmail"]</button>
        </div>
    </section>

    <section class="card">
        <h2>@L["ServerAdmin.Audit"]</h2>
        @if (_audit.Count == 0)
        {
            <p class="muted">@L["ServerAdmin.NoAudit"]</p>
        }
        else
        {
            <div class="timeline">
                @foreach (var entry in _audit)
                {
                    <div class="timeline-row">
                        <div class="timeline-icon accent">⚑</div>
                        <div class="timeline-main">
                            <div class="timeline-title">@entry.Action</div>
                            <div class="muted tiny">@entry.ActorEmail · @(entry.Detail ?? "")</div>
                        </div>
                        <div class="muted tiny">@Formats.CompactDateTime(entry.CreatedUtc.ToLocalTime())</div>
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    private Guid _familyId;
    private bool _isServerAdmin;
    private List<FamilyAdminDto> _families = [];
    private List<InvitationDto> _invitations = [];
    private List<ServerAdminAudit> _audit = [];
    private string? _inviteEmail;
    private string? _inviteFamilyName;
    private string? _createdLink;
    private bool _emailSent;
    private FamilyAdminDto? _deleting;
    private string _deleteConfirmation = "";
    private string? _error;
    private string? _notice;

    private string? _smtpHost;
    private int _smtpPort = 587;
    private bool _smtpSsl = true;
    private string? _smtpUsername;
    private string? _smtpPassword;
    private string? _smtpFrom;
    private string? _smtpFromName;
    private bool _hasSmtpPassword;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId);
        _isServerAdmin = string.Equals(auth.User.FindFirst("server_admin")?.Value, "true", StringComparison.OrdinalIgnoreCase);
        if (_isServerAdmin) await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var admin = scope.ServiceProvider.GetRequiredService<ServerAdminService>();
        var invites = scope.ServiceProvider.GetRequiredService<InvitationService>();
        var email = scope.ServiceProvider.GetRequiredService<EmailSender>();
        _families = await admin.ListFamiliesAsync();
        _invitations = await invites.ListAllPendingAsync();
        _audit = await admin.RecentAuditAsync();
        var settings = await email.EnsureSettingsAsync();
        _smtpHost = settings.SmtpHost;
        _smtpPort = settings.SmtpPort;
        _smtpSsl = settings.SmtpUseSsl;
        _smtpUsername = settings.SmtpUsername;
        _smtpFrom = settings.FromAddress;
        _smtpFromName = settings.FromName;
        _hasSmtpPassword = !string.IsNullOrWhiteSpace(settings.SmtpPasswordProtected);
    }

    private async Task InviteAsync()
    {
        _error = null; _notice = null; _createdLink = null;
        try
        {
            using var scope = Scopes.CreateScope();
            var invites = scope.ServiceProvider.GetRequiredService<InvitationService>();
            var auth = await AuthState.GetAuthenticationStateAsync();
            Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var actorId);
            var created = await invites.CreateFamilyInviteAsync(actorId, _inviteEmail, _inviteFamilyName);
            _createdLink = created.Link;
            _emailSent = created.EmailSent;
            _inviteEmail = null;
            _inviteFamilyName = null;
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task ResendAsync(InvitationDto invite)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            var result = await scope.ServiceProvider.GetRequiredService<InvitationService>().ResendAsync(invite.Id);
            _notice = result.Ok ? (result.EmailSent ? L["Team.InviteResent"] : result.Error) : result.Error;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task RevokeAsync(InvitationDto invite)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            await scope.ServiceProvider.GetRequiredService<InvitationService>().RevokeAsync(invite.Id);
            _notice = L["Team.InviteRevoked"];
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SetStatusAsync(FamilyAdminDto family, bool active)
    {
        try
        {
            using var scope = Scopes.CreateScope();
            var access = await scope.ServiceProvider.GetRequiredService<FamilyScope>().AccessAsync();
            await scope.ServiceProvider.GetRequiredService<ServerAdminService>()
                .SetStatusAsync(family.Id, active ? FamilyStatus.Active : FamilyStatus.Suspended, access.ParentId, access.DisplayName);
            _notice = active ? L["ServerAdmin.Reactivated"] : L["ServerAdmin.SuspendedNotice"];
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void CancelDelete()
    {
        _deleting = null;
        _deleteConfirmation = "";
    }

    private void BeginDelete(FamilyAdminDto family)
    {
        _deleting = family;
        _deleteConfirmation = "";
    }

    private async Task DeleteAsync()
    {
        if (_deleting is null) return;
        try
        {
            using var scope = Scopes.CreateScope();
            var access = await scope.ServiceProvider.GetRequiredService<FamilyScope>().AccessAsync();
            await scope.ServiceProvider.GetRequiredService<ServerAdminService>()
                .DeleteFamilyAsync(_deleting.Id, access.ParentId, access.DisplayName);
            _notice = L["ServerAdmin.Deleted"];
            _deleting = null;
            _deleteConfirmation = "";
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SaveSmtpAsync()
    {
        try
        {
            using var scope = Scopes.CreateScope();
            await scope.ServiceProvider.GetRequiredService<EmailSender>()
                .SaveSettingsAsync(_smtpHost, _smtpPort, _smtpSsl, _smtpUsername, _smtpPassword, _smtpFrom, _smtpFromName);
            _smtpPassword = null;
            _notice = L["ServerAdmin.SmtpSaved"];
            await RefreshAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task SendTestEmailAsync()
    {
        _error = null;
        _notice = null;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var address = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            if (string.IsNullOrWhiteSpace(address))
            {
                _error = L["EmailPreview.NoEmail"].Value;
                return;
            }
            using var scope = Scopes.CreateScope();
            var renderer = scope.ServiceProvider.GetRequiredService<EmailRenderer>();
            var rendered = renderer.RenderTest(System.Globalization.CultureInfo.CurrentUICulture.Name,
                auth.User.FindFirst(ParentalClaims.DisplayName)?.Value, DateTime.UtcNow);
            var (sent, error) = await scope.ServiceProvider.GetRequiredService<EmailSender>()
                .SendAsync(new EmailOutgoing(address, rendered));
            if (sent) _notice = L["Settings.TestEmailSent", address].Value;
            else _error = L["EmailPreview.Failed", error ?? ""].Value;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
