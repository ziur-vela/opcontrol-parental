@page "/settings"
@attribute [Authorize]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject BuildInfo Build
@inject Microsoft.Extensions.Options.IOptions<OpControl.Parental.Server.Services.BrandOptions> BrandOptions
@inject IStringLocalizer<AppStrings> L
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@L["Settings.PageTitle"]</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">@L["Settings.FamilyEyebrow"]</div>
        <h1>@L["Nav.Settings"]</h1>
        <p class="muted">@L["Settings.Subtitle"]</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert danger">@_error</div>
}
@if (_saved)
{
    <div class="alert ok">@L["Settings.Saved"]</div>
}
@if (_testNotice is not null)
{
    <div class="alert ok">@_testNotice</div>
}

<div class="card">
    <div class="card-title-row">
        <h2>@L["Settings.Language"]</h2>
        <span class="pill-soft">@L["Settings.MyLanguage"]</span>
    </div>
    <p class="muted small">@L["Settings.LanguageHelp"]</p>
    <div class="grid-2">
        <label class="field">
            <span>@L["Settings.MyLanguage"]</span>
            <select value="@_myLanguage" @onchange="SetMyLanguageAsync">
                <option value="en">@L["Language.English"]</option>
                <option value="es-MX">@L["Language.Spanish"]</option>
            </select>
        </label>
        <label class="field">
            <span>@L["Settings.FamilyLanguage"]</span>
            <select value="@_familyLanguage" disabled="@(!_isOwner)" @onchange="SetFamilyLanguageAsync">
                <option value="en">@L["Language.English"]</option>
                <option value="es-MX">@L["Language.Spanish"]</option>
            </select>
        </label>
    </div>
    <p class="muted tiny">@L["Settings.FamilyLanguageHelp"]</p>
</div>

<section class="card">
    <div class="card-title-row">
        <h2>@L["Settings.AlertEmails"]</h2>
        <span class="pill-soft">@(_isOwner ? L["Common.Owner"] : L["Common.ReadOnly"])</span>
    </div>
    <p class="muted small">@L["Settings.AlertEmailsHelp"]</p>
    <div class="stack">
        <label class="check"><input type="checkbox" @bind="_enabled" disabled="@(!_isOwner)" /> @L["Settings.SendAlertEmails"]</label>
        <div class="grid-2">
            <label class="field"><span>@L["Settings.SmtpHost"]</span><input @bind="_host" disabled="@(!_isOwner)" placeholder="smtp.example.com" /></label>
            <label class="field"><span>@L["Settings.SmtpPort"]</span><input type="number" min="1" max="65535" @bind="_port" disabled="@(!_isOwner)" /></label>
            <label class="field"><span>@L["Settings.SmtpUsername"]</span><input @bind="_username" disabled="@(!_isOwner)" /></label>
            <label class="field">
                <span>@L["Settings.SmtpPassword"] @(_hasPassword ? L["Settings.Stored"] : "")</span>
                <input type="password" @bind="_password" disabled="@(!_isOwner)" placeholder="@(_hasPassword ? L["Settings.LeaveBlankToKeep"] : "")" />
            </label>
            <label class="field"><span>@L["Settings.FromAddress"]</span><input @bind="_from" disabled="@(!_isOwner)" placeholder="parental@example.com" /></label>
            <label class="field"><span>@L["Settings.OfflineAfter"]</span><input type="number" min="5" max="1440" @bind="_offlineMinutes" disabled="@(!_isOwner)" /></label>
            <label class="field"><span>@L["Settings.RepeatedBlockHours"]</span><input type="number" min="1" max="24" @bind="_repeatedBlockHours" disabled="@(!_isOwner)" /><span class="muted tiny">@L["Settings.RepeatedBlockHoursHelp"]</span></label>
        </div>
        <label class="check"><input type="checkbox" @bind="_useSsl" disabled="@(!_isOwner)" /> @L["Settings.UseSsl"]</label>
        @if (_isOwner)
        {
            <div class="button-row">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">@L["Settings.SaveEmail"]</button>
                <button class="btn btn-ghost" disabled="@_busy" @onclick="SendTestEmailAsync">@L["Settings.SendTestEmail"]</button>
            </div>
        }
    </div>
</section>

<section class="card">
    <div class="card-title-row">
        <h2>@L["Settings.Notice"]</h2>
        <span class="pill-soft">@(_isOwner ? L["Common.Owner"] : L["Common.ReadOnly"])</span>
    </div>
    <p class="muted small">@L["Settings.NoticeHelp"]</p>
    <label class="field"><span>@L["Settings.NoticeText"]</span><input maxlength="80" @bind="_noticeText" disabled="@(!_isOwner)" placeholder="@L["Settings.NoticeDefault"]" /></label>
    @if (_isOwner)
    {
        <div class="button-row"><button class="btn btn-primary" disabled="@_busy" @onclick="SaveNoticeTextAsync">@L["Settings.SaveNotice"]</button></div>
    }
</section>

<div class="card">
    <h2>@L["Settings.OwnerAccount"]</h2>
    <p class="muted">@L["Settings.OwnerHelp1"] <a href="/team">@L["Nav.Parents"]</a>.</p>
</div>

<div class="card">
    <div class="card-title-row">
        <h2>@L["Settings.BuildVersion"]</h2>
        <span class="pill-soft">@L["Settings.Stamped"]</span>
    </div>
    <p class="muted small">@L["Settings.BuildHelp"]</p>
    <div class="version-line">@Build.DisplayVersion</div>
    <div class="muted tiny">@L["Settings.BuildDetail", Build.Version, Build.Commit, Build.BuildDate]</div>
    <div class="button-row">
        <a class="btn btn-ghost" href="/version" target="_blank">@L["Settings.OpenVersion"]</a>
        <a class="btn btn-ghost" href="/health" target="_blank">@L["Settings.OpenHealth"]</a>
    </div>
</div>

<div class="card">
    <div class="card-title-row">
        <h2>@L["Settings.OverridePin"]</h2>
        <span class="pill-soft">@(_hasPin ? L["Settings.PinSet"] : L["Settings.PinNotSet"])</span>
    </div>
    <p class="muted">@L["Settings.PinHelp", _childName ?? L["Settings.TheChild"]]</p>
    <a class="btn btn-primary" href="/pin">@(_hasPin ? L["Settings.ChangeOrClearPin"] : L["Home.SetPin"])</a>
</div>

<div class="card">
    <h2>@L["Settings.Security"]</h2>
    <p class="muted">@L["Settings.SecurityHelp"]</p>
    <a class="btn btn-primary" href="/account/2fa">@L["Settings.TwoFactor"]</a>
</div>

<div class="card">
    <h2>@L["Settings.AlertControls"]</h2>
    <p class="muted small">@L["Settings.AlertControlsHelp"]</p>
    <div class="grid-2">
        <label class="check"><input type="checkbox" @bind="_muteNewApp" disabled="@(!_isOwner)" /> @L["Settings.MuteNewApp"]</label>
        <label class="check"><input type="checkbox" @bind="_muteRepeated" disabled="@(!_isOwner)" /> @L["Settings.MuteRepeated"]</label>
        <label class="check"><input type="checkbox" @bind="_mutePin" disabled="@(!_isOwner)" /> @L["Settings.MutePin"]</label>
        <label class="check"><input type="checkbox" @bind="_muteLimit" disabled="@(!_isOwner)" /> @L["Settings.MuteLimit"]</label>
        <label class="check"><input type="checkbox" @bind="_muteOffline" disabled="@(!_isOwner)" /> @L["Settings.MuteOffline"]</label>
        <label class="check"><input type="checkbox" @bind="_muteTamper" disabled="@(!_isOwner)" /> @L["Settings.MuteTamper"]</label>
        <label class="check"><input type="checkbox" @bind="_muteChildMessage" disabled="@(!_isOwner)" /> @L["Settings.MuteChildMessage"]</label>
        <label class="field"><span>@L["Settings.QuietStart"]</span><input type="text" placeholder="22:00" @bind="_quietStart" disabled="@(!_isOwner)" /></label>
        <label class="field"><span>@L["Settings.QuietEnd"]</span><input type="text" placeholder="07:00" @bind="_quietEnd" disabled="@(!_isOwner)" /></label>
        <label class="check"><input type="checkbox" @bind="_digest" disabled="@(!_isOwner)" /> @L["Settings.Digest"]</label>
        <label class="field"><span>@L["Settings.DigestHour"]</span><input type="number" min="0" max="23" @bind="_digestHour" disabled="@(!_isOwner)" /></label>
    </div>
    <p class="muted tiny">@L["Settings.AlertControlsFootnote"]</p>
    @if (_isOwner)
    {
        <div class="button-row"><button class="btn btn-primary" disabled="@_busy" @onclick="SavePreferencesAsync">@L["Settings.SaveAlertControls"]</button></div>
    }
</div>

<div class="card">
    <h2>@L["Settings.Brand"]</h2>
    <p class="muted">@L["Settings.BrandHelp1"] <code>Branding</code>@L["Settings.BrandHelp2"]</p>
    <div class="brand-preview">
        <img src="@BrandOptions.Value.LogoLight" alt="@BrandOptions.Value.ProductName" />
    </div>
    <div class="muted tiny">@BrandOptions.Value.ProductName · @L["Settings.Accent"] @BrandOptions.Value.AccentColor</div>
</div>

@code {
    private Guid _familyId;
    private bool _isOwner;
    private bool _busy;
    private bool _saved;
    private string? _testNotice;
    private string? _error;
    private bool _enabled;
    private bool _useSsl = true;
    private string? _host;
    private int _port = 587;
    private string? _username;
    private string? _password;
    private string? _from;
    private int _offlineMinutes = 120;
    private int _installLinkMinutes = 1440;
    private int _repeatedBlockHours = 6;
    private bool _hasPassword;
    private bool _hasPin;
    private string? _childName;
    private bool _muteNewApp;
    private bool _muteRepeated;
    private bool _mutePin;
    private bool _muteLimit;
    private bool _muteOffline;
    private bool _muteTamper;
    private bool _muteChildMessage;
    private string _quietStart = "22:00";
    private string _quietEnd = "07:00";
    private bool _digest;
    private int _digestHour = 18;
    private string _noticeText = "";
    private Guid _parentId;
    private string _myLanguage = AppCulture.English;
    private string _familyLanguage = AppCulture.English;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
            return;
        _isOwner = string.Equals(auth.User.FindFirst("family_role")?.Value, "Owner", StringComparison.OrdinalIgnoreCase);
        Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out _parentId);
        using var scope = Scopes.CreateScope();
        var dbLanguages = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        _myLanguage = AppCulture.Normalize(await dbLanguages.Users.AsNoTracking().Where(u => u.Id == _parentId).Select(u => u.PreferredLanguage).FirstOrDefaultAsync());
        _familyLanguage = AppCulture.Normalize(await dbLanguages.Families.AsNoTracking().Where(f => f.Id == _familyId).Select(f => f.DefaultLanguage).FirstOrDefaultAsync());
        var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
        var settings = await alerts.EnsureSettingsAsync(_familyId);
        _enabled = settings.AlertEmailsEnabled;
        _host = settings.SmtpHost;
        _port = settings.SmtpPort;
        _useSsl = settings.SmtpUseSsl;
        _username = settings.SmtpUsername;
        _from = settings.FromAddress;
        _offlineMinutes = settings.OfflineAlertMinutes;
        _installLinkMinutes = settings.InstallLinkMinutes;
        _repeatedBlockHours = settings.RepeatedBlockAlertHours;
        _noticeText = settings.NoticeText == "Parent's watching you" ? "" : settings.NoticeText;
        _hasPassword = !string.IsNullOrWhiteSpace(settings.SmtpPasswordProtected);
        var db = dbLanguages;
        var child = await db.Children.AsNoTracking()
            .Where(c => c.FamilyId == _familyId)
            .OrderBy(c => c.CreatedUtc)
            .FirstOrDefaultAsync();
        if (child is not null)
        {
            _childName = child.Name;
            _hasPin = await scope.ServiceProvider.GetRequiredService<LockService>().HasPinAsync(_familyId, child.Id);
        }
        var preference = await alerts.EnsurePreferenceAsync(_familyId);
        _muteNewApp = preference.MutedNewApp;
        _muteRepeated = preference.MutedRepeatedBlock;
        _mutePin = preference.MutedPinOverride;
        _muteLimit = preference.MutedLimit;
        _muteOffline = preference.MutedOffline;
        _muteTamper = preference.MutedTampering;
        _muteChildMessage = preference.MutedChildMessage;
        _quietStart = FormatMinutes(preference.QuietStartMinutes);
        _quietEnd = FormatMinutes(preference.QuietEndMinutes);
        _digest = preference.DailyDigest;
        _digestHour = preference.DigestHour;
    }

    private async Task SendTestEmailAsync()
    {
        _busy = true;
        _error = null;
        _saved = false;
        _testNotice = null;
        try
        {
            using var scope = Scopes.CreateScope();
            var auth = await AuthState.GetAuthenticationStateAsync();
            var address = auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;
            if (string.IsNullOrWhiteSpace(address))
            {
                _error = L["EmailPreview.NoEmail"].Value;
                return;
            }
            var renderer = scope.ServiceProvider.GetRequiredService<EmailRenderer>();
            var settings = await scope.ServiceProvider.GetRequiredService<AlertService>().EnsureSettingsAsync(_familyId);
            var rendered = renderer.RenderTest(_myLanguage, auth.User.FindFirst("display_name")?.Value, DateTime.UtcNow);
            var (sent, error) = await scope.ServiceProvider.GetRequiredService<EmailSender>()
                .SendAsync(new EmailOutgoing(address, rendered), settings);
            if (sent) _testNotice = L["Settings.TestEmailSent", address].Value;
            else _error = L["EmailPreview.Failed", error ?? ""].Value;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveNoticeTextAsync()
    {
        if (!_isOwner) return;
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            using var scope = Scopes.CreateScope();
            var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
            await alerts.SaveNoticeTextAsync(_familyId, _noticeText);
            _noticeText = string.IsNullOrWhiteSpace(_noticeText) ? L["Settings.NoticeDefault"].Value : _noticeText.Trim();
            _saved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SetMyLanguageAsync(ChangeEventArgs e)
    {
        var language = AppCulture.Normalize(e.Value?.ToString());
        using var scope = Scopes.CreateScope();
        await scope.ServiceProvider.GetRequiredService<LanguageService>().SetParentLanguageAsync(_parentId, language);
        _myLanguage = language;
        await JS.InvokeVoidAsync("ocpSetLanguageCookie", language);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task SetFamilyLanguageAsync(ChangeEventArgs e)
    {
        if (!_isOwner) return;
        var language = AppCulture.Normalize(e.Value?.ToString());
        using var scope = Scopes.CreateScope();
        await scope.ServiceProvider.GetRequiredService<LanguageService>().SetFamilyLanguageAsync(_familyId, language);
        _familyLanguage = language;
        // Family default is for invitations and children's devices; it does not change this parent's own dashboard language.
    }

    private static string FormatMinutes(int minutes) => $"{minutes / 60:00}:{minutes % 60:00}";

    private static int ParseMinutes(string? value)
    {
        if (TimeSpan.TryParse(value, out var span)) return Math.Clamp((int)span.TotalMinutes, 0, 1439);
        return 0;
    }

    private async Task SavePreferencesAsync()
    {
        if (!_isOwner) return;
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            using var scope = Scopes.CreateScope();
            var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
            await alerts.SavePreferenceAsync(_familyId, new OpControl.Parental.Contracts.AlertPreferencesDto(
                _muteNewApp, _muteRepeated, _mutePin, _muteLimit, _muteOffline, _muteTamper, _muteChildMessage,
                ParseMinutes(_quietStart), ParseMinutes(_quietEnd), _digest, _digestHour));
            _saved = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task SaveAsync()
    {
        if (!_isOwner) return;
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            using var scope = Scopes.CreateScope();
            var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
            await alerts.SaveSettingsAsync(_familyId, _enabled, _host, _port, _useSsl, _username, _password, _from, _offlineMinutes, _installLinkMinutes, _repeatedBlockHours);
            _hasPassword |= !string.IsNullOrWhiteSpace(_password);
            _password = null;
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
