@page "/settings"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes

<PageTitle>Settings · Parental OpControl</PageTitle>

<div class="page-head">
    <div>
        <div class="eyebrow">Family</div>
        <h1>Settings</h1>
        <p class="muted">Owner settings for alert emails. Push notifications are a later job.</p>
    </div>
</div>

@if (_error is not null)
{
    <div class="alert danger">@_error</div>
}
@if (_saved)
{
    <div class="alert ok">Settings saved.</div>
}

<section class="card">
    <div class="card-title-row">
        <h2>Alert emails</h2>
        <span class="pill-soft">@(_isOwner ? "Owner" : "Read only")</span>
    </div>
    <p class="muted small">Email notifications are off by default. When enabled, new alerts are sent to every parent account with an email address.</p>
    <div class="stack">
        <label class="check"><input type="checkbox" @bind="_enabled" disabled="@(!_isOwner)" /> Send alert emails</label>
        <div class="grid-2">
            <label class="field"><span>SMTP host</span><input @bind="_host" disabled="@(!_isOwner)" placeholder="smtp.example.com" /></label>
            <label class="field"><span>SMTP port</span><input type="number" min="1" max="65535" @bind="_port" disabled="@(!_isOwner)" /></label>
            <label class="field"><span>SMTP username</span><input @bind="_username" disabled="@(!_isOwner)" /></label>
            <label class="field">
                <span>SMTP password @(_hasPassword ? "(stored)" : "")</span>
                <input type="password" @bind="_password" disabled="@(!_isOwner)" placeholder="@(_hasPassword ? "Leave blank to keep" : "")" />
            </label>
            <label class="field"><span>From address</span><input @bind="_from" disabled="@(!_isOwner)" placeholder="parental@example.com" /></label>
            <label class="field"><span>Device offline alert after (minutes)</span><input type="number" min="5" max="1440" @bind="_offlineMinutes" disabled="@(!_isOwner)" /></label>
        </div>
        <label class="check"><input type="checkbox" @bind="_useSsl" disabled="@(!_isOwner)" /> Use SSL/TLS</label>
        @if (_isOwner)
        {
            <div class="button-row">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">Save email settings</button>
            </div>
        }
    </div>
</section>

<div class="card">
    <h2>Owner account</h2>
    <p class="muted">First-run setup creates the owner. Additional parents will be invited by the owner in a later job.</p>
</div>

<div class="card">
    <h2>Security</h2>
    <p class="muted">Protect parent sign-in with an authenticator app (TOTP).</p>
    <a class="btn btn-primary" href="/account/2fa">Two-factor authentication</a>
</div>

<div class="card">
    <h2>Brand</h2>
    <p class="muted">The product name, logo and accent color are kept in one place so they can be swapped without code changes.</p>
    <div class="brand-preview">
        <img src="/brand/lockup-color.svg" alt="Parental OpControl" />
    </div>
</div>

@code {
    private Guid _familyId;
    private bool _isOwner;
    private bool _busy;
    private bool _saved;
    private string? _error;
    private bool _enabled;
    private bool _useSsl = true;
    private string? _host;
    private int _port = 587;
    private string? _username;
    private string? _password;
    private string? _from;
    private int _offlineMinutes = 120;
    private bool _hasPassword;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
            return;
        _isOwner = string.Equals(auth.User.FindFirst("family_role")?.Value, "Owner", StringComparison.OrdinalIgnoreCase);
        using var scope = Scopes.CreateScope();
        var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
        var settings = await alerts.EnsureSettingsAsync(_familyId);
        _enabled = settings.AlertEmailsEnabled;
        _host = settings.SmtpHost;
        _port = settings.SmtpPort;
        _useSsl = settings.SmtpUseSsl;
        _username = settings.SmtpUsername;
        _from = settings.FromAddress;
        _offlineMinutes = settings.OfflineAlertMinutes;
        _hasPassword = !string.IsNullOrWhiteSpace(settings.SmtpPasswordProtected);
    }

    private async Task SaveAsync()
    {
        if (!_isOwner) return;
        _busy = true;
        _error = null;
        _saved = false;
        try
        {
            using var scope = Scopes.CreateScope();
            var alerts = scope.ServiceProvider.GetRequiredService<AlertService>();
            await alerts.SaveSettingsAsync(_familyId, _enabled, _host, _port, _useSsl, _username, _password, _from, _offlineMinutes);
            _hasPassword |= !string.IsNullOrWhiteSpace(_password);
            _password = null;
            _saved = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
