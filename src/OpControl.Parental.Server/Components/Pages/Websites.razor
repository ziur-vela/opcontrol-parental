@page "/websites"
@attribute [Authorize(Policy = ParentalPolicies.WebsiteRules)]
@rendermode InteractiveServer
@using OpControl.Parental.Server.Auth
@using Microsoft.EntityFrameworkCore
@using OpControl.Parental.Contracts
@using OpControl.Parental.Server.Data
@using OpControl.Parental.Server.Services
@inject AuthenticationStateProvider AuthState
@inject IServiceScopeFactory Scopes
@inject IStringLocalizer<AppStrings> L

<PageTitle>@L["Websites.PageTitle"]</PageTitle>

@if (_loading)
{
    <div class="card"><div class="skeleton-line"></div><div class="skeleton-line short"></div></div>
}
else if (_childId == Guid.Empty)
{
    <div class="card"><h1>@L["Common.NoChildYet"]</h1><p class="muted">@L["Common.CreateChildFirst"]</p></div>
}
else
{
    <div class="page-head">
        <div>
            <div class="eyebrow">@_childName</div>
            <h1>@L["Nav.Websites"]</h1>
            <p class="muted">@L["Websites.Subtitle"]</p>
        </div>
        <div class="button-row">
            <a class="btn btn-ghost" href="/apps">@L["Nav.Apps"]</a>
            <a class="btn btn-ghost" href="/schedules">@L["Nav.Schedules"]</a>
        </div>
    </div>

    @if (_toast is not null)
    {
        <div class="toast @(_toastError ? "danger" : "ok")" role="status">@_toast</div>
    }

    @if (_error is not null)
    {
        <div class="alert danger">@_error</div>
    }

    <div class="grid-2">
        <section class="card">
            <div class="card-title-row">
                <h2>@L["Websites.VisitedSites"]</h2>
                <div class="date-nav">
                    <button class="icon-btn" @onclick="() => ShiftDate(-1)" title="@L["Websites.PreviousDay"]">‹</button>
                    <input type="date" class="mini-input" @bind="_date" @bind:after="RefreshAsync" />
                    <button class="icon-btn" @onclick="() => ShiftDate(1)" title="@L["Websites.NextDay"]">›</button>
                </div>
            </div>

            <div class="chip-row">
                @foreach (var filter in Filters)
                {
                    <button class="chip @(_filter == filter.Key ? "active" : "")" @onclick="() => SetFilter(filter.Key)">@L[filter.LabelKey]</button>
                }
            </div>

            <form class="inline-add" @onsubmit="AddSiteAsync" @onsubmit:preventDefault>
                <input class="mini-input grow" placeholder="@L["Websites.DomainPlaceholder"]" @bind="_newDomain" />
                <select class="mini-input" @bind="_newAction">
                    <option value="block">@L["Common.Block"]</option>
                    <option value="allow">@L["Common.Allow"]</option>
                </select>
                @if (_newAction == "block")
                {
                    <select class="mini-input" @bind="_newMode">
                        <option value="always">@L["Websites.Always"]</option>
                        <option value="scheduled">@L["Websites.DuringSchedule"]</option>
                    </select>
                    <select class="mini-input" @bind="_newScheduleId" disabled="@(_newMode != "scheduled")">
                        <option value="">@L["Websites.SchedulePlaceholder"]</option>
                        @foreach (var schedule in _schedules)
                        {
                            <option value="@schedule.Id">@schedule.Name</option>
                        }
                    </select>
                }
                <button class="btn @(_newAction == "allow" ? "btn-accent" : "btn-primary")" type="submit">@L[_newAction == "allow" ? "Common.Allow" : "Common.Block"]</button>
            </form>

            @if (FilteredSites.Count == 0)
            {
                <p class="muted">@L["Websites.NoVisitsDay"]</p>
            }
            else
            {
                <div class="rule-list">
                    @foreach (var site in FilteredSites)
                    {
                        <div class="rule-row">
                            <div class="rule-main">
                                <div class="rule-title">@site.Domain</div>
                                <div class="muted tiny">
                                    @L[site.Count == 1 ? "Common.VisitCount" : "Common.VisitCountPlural", site.Count] · @L["Websites.LastVisit", FormatLocal(site.LastUtc)]
                                    @if (site.BlockedAttempts > 0)
                                    {
                                        <span> · @BlockedAttempts(site.BlockedAttempts) · @BlockReasonText.Describe(site.BlockReason)</span>
                                    }
                                    @if (site.IsNewThisWeek)
                                    {
                                        <span class="pill-soft tiny-pill">@L["Websites.NewThisWeek"]</span>
                                    }
                                </div>
                            </div>
                            <div class="rule-actions">
                                <button class="ghost-btn" @onclick="() => OpenReviewAsync(site.Domain)">@L["Website.Review.Button"]</button>
                                @if (site.IsBlocked)
                                {
                                    <span class="state-pill blocked">@L["Common.Blocked"]</span>
                                    <button class="ghost-btn" @onclick="() => AllowDomainAsync(site.Domain, false)">
                                        @L[RuleAvailability.CanUnblock(site.RuleId) ? "Common.Allow" : "Websites.AllowException"]
                                    </button>
                                    @if (RuleAvailability.CanUnblock(site.RuleId))
                                    {
                                        <button class="ghost-btn" @onclick="() => RemoveRuleAsync(site.RuleId, site.Domain)">@L["Websites.Unblock"]</button>
                                    }
                                }
                                else if (site.IsAllowed)
                                {
                                    <span class="state-pill allowed">@L["Common.Allowed"]</span>
                                    <button class="ghost-btn" @onclick="() => BlockSiteAsync(site.Domain, RuleMode.Always, null)">@L["Common.Block"]</button>
                                }
                                else
                                {
                                    <button class="btn btn-accent" @onclick="() => BlockSiteAsync(site.Domain, RuleMode.Always, null)">@L["Common.Block"]</button>
                                    <button class="ghost-btn" @onclick="() => AllowDomainAsync(site.Domain, false)">@L["Common.Allow"]</button>
                                }
                                @if (site.IsBlocked)
                                {
                                    <button class="ghost-btn" @onclick="() => BonusAsync(site.Domain, 15)">@L["Home.Bonus15"]</button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card">
            <div class="card-title-row">
                <h2>@L["Websites.Rules"]</h2>
                <span class="pill-soft">@L["Websites.RuleCounts", _rules.Count(r => r.IsBlocked), _rules.Count(r => !r.IsBlocked)]</span>
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Websites.BlockedAlways"]</div>
                @foreach (var rule in _rules.Where(r => r.IsBlocked && r.Mode == RuleMode.Always))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@rule.Domain</div>
                            <div class="muted tiny">@L["Websites.Since", FormatLocal(rule.UpdatedUtc)]</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => OpenReviewAsync(rule.Domain)">@L["Website.Review.Button"]</button>
                            <button class="ghost-btn" @onclick="() => BonusAsync(rule.Domain, 15)">@L["Home.Bonus15"]</button>
                            <button class="ghost-btn" @onclick="() => AllowDomainAsync(rule.Domain, false)">@L["Common.Allow"]</button>
                            <button class="ghost-btn" @onclick="() => RemoveRuleAsync(rule.Id, rule.Domain)">@L["Websites.Unblock"]</button>
                        </div>
                    </div>
                }
                @if (!_rules.Any(r => r.IsBlocked && r.Mode == RuleMode.Always))
                {
                    <p class="muted tiny">@L["Websites.NoAlwaysBlocked"]</p>
                }
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Websites.BlockedDuringSchedule"]</div>
                @foreach (var rule in _rules.Where(r => r.IsBlocked && r.Mode == RuleMode.Scheduled))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@rule.Domain</div>
                            <div class="muted tiny">@ScheduleName(rule.ScheduleId)</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => OpenReviewAsync(rule.Domain)">@L["Website.Review.Button"]</button>
                            <button class="ghost-btn" @onclick="() => AllowDomainAsync(rule.Domain, false)">@L["Common.Allow"]</button>
                            <button class="ghost-btn" @onclick="() => RemoveRuleAsync(rule.Id, rule.Domain)">@L["Websites.Unblock"]</button>
                        </div>
                    </div>
                }
                @if (!_rules.Any(r => r.IsBlocked && r.Mode == RuleMode.Scheduled))
                {
                    <p class="muted tiny">@L["Websites.NoScheduledRules"]</p>
                }
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Websites.AllowedAlways"]</div>
                @foreach (var rule in _rules.Where(r => !r.IsBlocked))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@rule.Domain</div>
                            <div class="muted tiny">@OverrideText(rule.Domain)</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => OpenReviewAsync(rule.Domain)">@L["Website.Review.Button"]</button>
                            <button class="ghost-btn" @onclick="() => BlockSiteAsync(rule.Domain, RuleMode.Always, null)">@L["Common.Block"]</button>
                        </div>
                    </div>
                }
                @if (!_rules.Any(r => !r.IsBlocked))
                {
                    <p class="muted tiny">@L["Websites.NoAlwaysAllowed"]</p>
                }
            </div>

            <div class="rule-section">
                <div class="eyebrow">@L["Websites.Categories"]</div>
                @foreach (var category in _categories)
                {
                    <div class="toggle-row">
                        <div>
                            <div class="rule-title">@CategoryText.Name(category.Key, category.Name)</div>
                            <div class="muted tiny">v@(category.Version)</div>
                        </div>
                        <button class="toggle @(category.Enabled ? "on" : "")" @onclick="() => ToggleCategoryAsync(category.Key, !category.Enabled)">
                            <span></span>
                        </button>
                    </div>
                }
            </div>
        </section>
    </div>

    <section class="card">
        <div class="card-title-row">
            <h2>@L["Websites.History"]</h2>
            <span class="pill-soft">@L["Websites.LatestCount", Math.Min(_history.Count, 20)]</span>
        </div>
        @if (_history.Count == 0)
        {
            <p class="muted">@L["Websites.NoHistory"]</p>
        }
        else
        {
            <div class="rule-list">
                @foreach (var item in _history.Where(h => h.RuleType == "site").Take(20))
                {
                    <div class="rule-row compact">
                        <div class="rule-main">
                            <div class="rule-title">@item.Identity</div>
                            <div class="muted tiny">@ActionLabel(item.Action) · @FormatLocal(item.ChangedUtc)</div>
                        </div>
                        <div class="rule-actions">
                            <button class="ghost-btn" @onclick="() => BlockSiteAsync(item.Identity, RuleMode.Always, null)">@L["Websites.BlockAgain"]</button>
                            <button class="ghost-btn" @onclick="() => AllowDomainAsync(item.Identity, false)">@L["Websites.AllowAgain"]</button>
                        </div>
                    </div>
                }
            </div>
        }
    </section>
}

    @if (_review is not null || _reviewLoading)
    {
        <div class="review-backdrop" @onclick="CloseReview"></div>
        <aside class="review-panel" role="dialog" aria-modal="true" aria-label="@L["Website.Review.Title"]">
            <div class="review-head">
                <div>
                    <div class="eyebrow">@L["Website.Review.Eyebrow"]</div>
                    <h2>@(_review?.Domain ?? "…")</h2>
                </div>
                <button type="button" class="icon-btn" aria-label="@L["Common.Close"]" @onclick="CloseReview">×</button>
            </div>
            @if (_reviewLoading)
            {
                <div class="skeleton-line"></div><div class="skeleton-line short"></div>
            }
            else if (_review is not null)
            {
                @if (_adultConfirmed || !_review.IsAdult)
                {
                    <div class="review-site">
                        @if (_review.FaviconUrl is not null)
                        {
                            <img class="review-favicon" src="@FaviconUrl(_review.Domain)" alt="" width="24" height="24" />
                        }
                        <div>
                            <div class="rule-title">@(_review.Title ?? _review.Domain)</div>
                            @if (_review.Description is not null)
                            {
                                <p class="muted tiny">@_review.Description</p>
                            }
                        </div>
                    </div>
                    @if (_review.FetchError is not null)
                    {
                        <p class="muted tiny">@L[_review.FetchError]</p>
                    }
                }
                @if (_review.IsAdult && !_adultConfirmed)
                {
                    <div class="alert danger">@L["Website.Review.AdultNotice"]</div>
                }
                @if (_review.KnownPurposeKey is not null)
                {
                    <p class="muted tiny">@L[_review.KnownPurposeKey]</p>
                }
                <div class="review-meta">
                    <div class="review-line"><span class="muted">@L["Website.Review.Categories"]</span>
                        <span>@(_review.Categories.Count == 0 ? L["Website.Review.NoCategories"].Value : string.Join(", ", _review.Categories.Select(CategoryName)))</span>
                    </div>
                    <div class="review-line"><span class="muted">@L["Website.Review.BlockedBy"]</span>
                        <span>@(_review.BlockReason is null ? L["Website.Review.NotBlocked"].Value : BlockReasonText.Describe(_review.BlockReason))</span>
                    </div>
                    <div class="review-line"><span class="muted">@L["Website.Review.Visits7"]</span><span>@_review.VisitCount</span></div>
                    <div class="review-line"><span class="muted">@L["Website.Review.Lookups7"]</span><span>@_review.LookupCount</span></div>
                    <div class="review-line"><span class="muted">@L["Website.Review.FirstSeen"]</span><span>@FormatOptional(_review.FirstSeenUtc)</span></div>
                    <div class="review-line"><span class="muted">@L["Website.Review.LastSeen"]</span><span>@FormatOptional(_review.LastSeenUtc)</span></div>
                </div>
                <div class="review-actions">
                    @if (_review.IsAdult && !_adultConfirmed)
                    {
                        <button type="button" class="btn btn-ghost" @onclick="() => _adultConfirmed = true">@L["Website.Review.VisitWithWarning"]</button>
                    }
                    else
                    {
                        <a class="btn btn-ghost" href="@("https://" + _review.Domain)" target="_blank" rel="noopener noreferrer">@L["Website.Review.Visit"]</a>
                    }
                    <button type="button" class="btn btn-accent" @onclick="() => BlockSiteAsync(_review.Domain, RuleMode.Always, null)">@L["Website.Review.BlockAlways"]</button>
                    <div class="review-schedule">
                        <select class="mini-input" @bind="_reviewScheduleId">
                            <option value="">@L["Websites.SchedulePlaceholder"]</option>
                            @foreach (var schedule in _schedules)
                            {
                                <option value="@schedule.Id">@schedule.Name</option>
                            }
                        </select>
                        <button type="button" class="ghost-btn" disabled="@(string.IsNullOrEmpty(_reviewScheduleId))"
                                @onclick="BlockDuringScheduleAsync">@L["Website.Review.BlockSchedule"]</button>
                    </div>
                    <button type="button" class="ghost-btn" @onclick="() => AllowDomainAsync(_review.Domain, true)">
                        @L[_review.BlockReason?.StartsWith("category:", StringComparison.Ordinal) == true ? "Websites.AllowException" : "Common.Allow"]
                    </button>
                    @if (RuleAvailability.CanUnblock(_review.RuleId))
                    {
                        <button type="button" class="ghost-btn" @onclick="UnblockReviewAsync">@L["Websites.Unblock"]</button>
                    }
                </div>
            }
        </aside>
    }

    @if (_relatedService is not null)
    {
        <div class="review-backdrop" @onclick="CloseRelated"></div>
        <div class="modal-card" role="dialog" aria-modal="true" aria-label="@L["Websites.RelatedTitle", L[_relatedService.LabelKey]]">
            <div class="review-head">
                <div>
                    <div class="eyebrow">@L["Websites.RelatedEyebrow"]</div>
                    <h2>@L["Websites.RelatedTitle", L[_relatedService.LabelKey]]</h2>
                </div>
                <button type="button" class="icon-btn" aria-label="@L["Common.Close"]" @onclick="CloseRelated">×</button>
            </div>
            <p class="muted tiny">@L["Websites.RelatedHint"]</p>
            <div class="check-list">
                @foreach (var choice in _related)
                {
                    <label class="check-row">
                        <input type="checkbox" @bind="choice.Selected" />
                        <span>@choice.Domain</span>
                    </label>
                }
            </div>
            <div class="button-row">
                <button type="button" class="btn btn-primary" @onclick="AllowRelatedAsync">@L["Websites.AllowSelected"]</button>
                <button type="button" class="btn btn-ghost" @onclick="CloseRelated">@L["Websites.NotNow"]</button>
            </div>
        </div>
    }

@code {
    private static readonly (string Key, string LabelKey)[] Filters =
    [
        ("all", "Websites.FilterAll"),
        ("notblocked", "Websites.FilterNotBlocked"),
        ("blocked", "Websites.FilterBlocked"),
        ("new", "Websites.NewThisWeek")
    ];

    private sealed class RelatedChoice
    {
        public string Domain { get; init; } = "";
        public bool Selected { get; set; }
    }

    private sealed class SiteRow
    {
        public string Domain { get; init; } = "";
        public int Count { get; init; }
        public DateTime LastUtc { get; init; }
        public int BlockedAttempts { get; init; }
        public string? BlockReason { get; init; }
        public bool IsBlocked { get; init; }
        public bool IsAllowed { get; init; }
        public Guid RuleId { get; init; }
        public bool IsNewThisWeek { get; init; }
    }

    private Guid _familyId;
    private Guid _childId;
    private string _childName = "";
    private string _timeZoneId = "UTC";
    private bool _loading = true;
    private string? _error;
    private string _filter = "all";
    private DateTime _date = DateTime.Today;
    private string _newDomain = "";
    private string _newAction = "block";
    private string _newMode = "always";
    private string _newScheduleId = "";
    private string? _toast;
    private bool _toastError;
    private KnownSites.KnownService? _relatedService;
    private List<RelatedChoice> _related = [];
    private Dictionary<string, string> _overrideByDomain = new(StringComparer.OrdinalIgnoreCase);
    private List<Schedule> _schedules = [];
    private List<WebsiteRule> _rules = [];
    private List<CategoryToggleDto> _categories = [];
    private List<RuleHistoryDto> _history = [];
    private List<SiteRow> _allSites = [];
    private List<SiteRow> _filteredSites = [];
    private SiteReviewResult? _review;
    private bool _reviewLoading;
    private bool _adultConfirmed;
    private string _reviewScheduleId = "";

    private List<SiteRow> FilteredSites => _filteredSites;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        if (!Guid.TryParse(auth.User.FindFirst("family_id")?.Value, out _familyId))
        {
            _loading = false;
            _error = L["Home.MissingFamilyScope"];
            return;
        }
        _date = DateTime.Today;
        await RefreshAsync();
        _loading = false;
    }

    private void SetFilter(string key)
    {
        _filter = key;
        ApplyFilter();
    }

    private void ShiftDate(int days)
    {
        _date = _date.AddDays(days);
        _ = RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        using var scope = Scopes.CreateScope();
        var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
        var child = await db.Children.AsNoTracking().Where(c => c.FamilyId == _familyId).OrderBy(c => c.CreatedUtc).FirstOrDefaultAsync();
        if (child is null) { _childId = Guid.Empty; return; }
        _childId = child.Id;
        _childName = child.Name;
        _timeZoneId = await db.Devices.AsNoTracking().Where(d => d.ChildId == child.Id).Select(d => d.TimeZoneId).FirstOrDefaultAsync() ?? "UTC";

        _rules = await db.WebsiteRules.AsNoTracking()
            .Where(r => r.FamilyId == _familyId && r.ChildId == child.Id)
            .OrderBy(r => r.Domain)
            .ToListAsync();
        _schedules = await db.Schedules.AsNoTracking()
            .Where(s => s.FamilyId == _familyId && s.ChildId == child.Id)
            .OrderBy(s => s.Name)
            .ToListAsync();

        var rulesService = scope.ServiceProvider.GetRequiredService<RuleService>();
        var policy = await rulesService.GetDevicePolicyAsync(_familyId, child.Id);
        _categories = policy.Categories.ToList();
        _history = await rulesService.GetHistoryAsync(_familyId, child.Id, 60);

        var enabledKeys = _categories.Where(c => c.Enabled).Select(c => c.Key).ToList();
        var allowedDomains = _rules.Where(r => !r.IsBlocked).Select(r => r.Domain).ToList();
        _overrideByDomain = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (enabledKeys.Count > 0 && allowedDomains.Count > 0)
        {
            var matches = await db.CategoryDomains.AsNoTracking()
                .Where(d => enabledKeys.Contains(d.CategoryKey) && d.RemovedVersion == null && allowedDomains.Contains(d.Domain))
                .Select(d => new { d.Domain, d.CategoryKey })
                .ToListAsync();
            foreach (var match in matches) _overrideByDomain.TryAdd(match.Domain, match.CategoryKey);
        }

        var tz = ResolveTimeZone(_timeZoneId);
        var date = DateOnly.FromDateTime(_date);
        var startUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(date.ToDateTime(TimeOnly.MinValue), DateTimeKind.Unspecified), tz);
        var endUtc = TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(date.AddDays(1).ToDateTime(TimeOnly.MinValue), DateTimeKind.Unspecified), tz);
        var weekStart = DateTime.UtcNow.AddDays(-7);

        var visits = await db.VisitRecords.AsNoTracking()
            .Where(v => v.FamilyId == _familyId && v.ChildId == child.Id && v.VisitedUtc >= startUtc && v.VisitedUtc < endUtc)
            .ToListAsync();
        var firstSeen = await db.VisitRecords.AsNoTracking()
            .Where(v => v.FamilyId == _familyId && v.ChildId == child.Id)
            .GroupBy(v => v.Domain)
            .Select(g => new { Domain = g.Key, First = g.Min(v => v.VisitedUtc) })
            .ToDictionaryAsync(x => x.Domain, x => x.First);

        var enabledCategories = _categories.Where(c => c.Enabled).Select(c => c.Key).ToList();
        var candidates = visits.Select(v => v.Domain).Distinct().SelectMany(Parents).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var categoryDomains = enabledCategories.Count == 0
            ? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            : (await db.CategoryDomains.AsNoTracking()
                .Where(d => enabledCategories.Contains(d.CategoryKey) && d.RemovedVersion == null && candidates.Contains(d.Domain))
                .Select(d => d.Domain)
                .ToListAsync()).ToHashSet(StringComparer.OrdinalIgnoreCase);

        var rows = new List<SiteRow>();
        foreach (var group in visits.GroupBy(v => v.Domain))
        {
            var domain = group.Key;
            var rule = _rules.FirstOrDefault(r => r.Domain == domain);
            var blocked = rule is { IsBlocked: true };
            var allowed = rule is { IsBlocked: false };
            if (!blocked && !allowed)
            {
                foreach (var parent in Parents(domain))
                {
                    var parentRule = _rules.FirstOrDefault(r => r.Domain == parent);
                    if (parentRule is { IsBlocked: true }) { blocked = true; rule = parentRule; break; }
                    if (parentRule is { IsBlocked: false }) { allowed = true; rule = parentRule; break; }
                }
            }
            if (!blocked && !allowed)
                blocked = Parents(domain).Any(p => categoryDomains.Contains(p));

            rows.Add(new SiteRow
            {
                Domain = domain,
                Count = group.Count(),
                LastUtc = group.Max(v => v.VisitedUtc),
                BlockedAttempts = group.Sum(v => v.BlockedLookups > 0 ? v.BlockedLookups : v.Blocked ? Math.Max(1, v.Lookups) : 0),
                BlockReason = group.Where(v => v.Blocked).Select(v => v.BlockReason).FirstOrDefault(r => !string.IsNullOrWhiteSpace(r)),
                IsBlocked = blocked,
                IsAllowed = allowed,
                RuleId = rule?.Id ?? Guid.Empty,
                IsNewThisWeek = firstSeen.TryGetValue(domain, out var first) && first >= weekStart
            });
        }

        _allSites = rows.OrderByDescending(r => r.LastUtc).ToList();
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        _filteredSites = _filter switch
        {
            "blocked" => _allSites.Where(s => s.BlockedAttempts > 0).ToList(),
            "notblocked" => _allSites.Where(s => !s.IsBlocked).ToList(),
            "new" => _allSites.Where(s => s.IsNewThisWeek).ToList(),
            _ => _allSites
        };
    }

    private async Task AddSiteAsync()
    {
        if (string.IsNullOrWhiteSpace(_newDomain)) return;
        if (_newAction == "allow")
        {
            if (await AllowDomainAsync(_newDomain.Trim(), false)) _newDomain = "";
            return;
        }
        var mode = _newMode == "scheduled" ? RuleMode.Scheduled : RuleMode.Always;
        Guid? scheduleId = Guid.TryParse(_newScheduleId, out var id) ? id : null;
        if (await BlockSiteAsync(_newDomain.Trim(), mode, scheduleId)) _newDomain = "";
    }

    private async Task<bool> BlockSiteAsync(string domain, RuleMode mode, Guid? scheduleId)
    {
        var ok = await RunAsync(async (db, rules, parentId) =>
        {
            await rules.UpsertWebsiteRuleAsync(_familyId, _childId, parentId, domain, blocked: true, mode, scheduleId);
            await db.SaveChangesAsync();
        }, L["Websites.BlockedToast", domain]);
        if (ok && _review is not null && _review.Domain.Equals(domain, StringComparison.OrdinalIgnoreCase))
            await OpenReviewAsync(domain);
        return ok;
    }

    private async Task<bool> AllowDomainAsync(string domain, bool fromReview)
    {
        var ok = await RunAsync(async (db, rules, parentId) =>
        {
            await rules.UpsertWebsiteRuleAsync(_familyId, _childId, parentId, domain, blocked: false, RuleMode.Always, null);
            await db.SaveChangesAsync();
        }, L["Websites.AllowedToast", domain]);
        if (ok)
        {
            if (fromReview && _review is not null && _review.Domain.Equals(domain, StringComparison.OrdinalIgnoreCase))
                await OpenReviewAsync(domain);
            OfferRelatedDomains(domain);
        }
        return ok;
    }

    private async Task RemoveRuleAsync(Guid ruleId, string domain)
    {
        if (!RuleAvailability.CanUnblock(ruleId)) return;
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.RemoveWebsiteRuleAsync(_familyId, _childId, parentId, ruleId);
            await db.SaveChangesAsync();
        }, L["Websites.UnblockedToast", domain]);
        if (_review is not null && _review.Domain.Equals(domain, StringComparison.OrdinalIgnoreCase))
            await OpenReviewAsync(domain);
    }

    private async Task BonusAsync(string domain, int minutes)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.AddItemBonusAsync(_familyId, _childId, parentId, "site", domain, minutes);
            await db.SaveChangesAsync();
        }, L["Websites.BonusToast", minutes, domain]);
    }

    private async Task ToggleCategoryAsync(string key, bool enabled)
    {
        await RunAsync(async (db, rules, parentId) =>
        {
            await rules.ToggleCategoryAsync(_familyId, _childId, parentId, key, enabled);
            await db.SaveChangesAsync();
        }, L["Websites.CategoryToast"]);
    }

    private void OfferRelatedDomains(string domain)
    {
        var service = KnownSites.ServiceFor(domain);
        if (service is null) return;
        var existing = _rules.Where(r => !r.IsBlocked).Select(r => r.Domain).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var choices = KnownSites.RelatedDomains(domain).Where(d => !existing.Contains(d)).ToList();
        if (choices.Count == 0) return;
        _relatedService = service;
        _related = choices.Select(d => new RelatedChoice { Domain = d }).ToList();
        StateHasChanged();
    }

    private void CloseRelated()
    {
        _relatedService = null;
        _related = [];
    }

    private async Task AllowRelatedAsync()
    {
        var selected = _related.Where(c => c.Selected).Select(c => c.Domain).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
        if (selected.Count == 0)
        {
            CloseRelated();
            return;
        }
        var ok = await RunAsync(async (db, rules, parentId) =>
        {
            foreach (var domain in selected)
                await rules.UpsertWebsiteRuleAsync(_familyId, _childId, parentId, domain, blocked: false, RuleMode.Always, null);
            await db.SaveChangesAsync();
        }, L[selected.Count == 1 ? "Websites.RelatedAllowedToastOne" : "Websites.RelatedAllowedToast", selected.Count]);
        if (ok)
        {
            CloseRelated();
            if (_review is not null) await OpenReviewAsync(_review.Domain);
        }
    }

    private async Task OpenReviewAsync(string domain)
    {
        _reviewLoading = true;
        _review = null;
        _adultConfirmed = false;
        _reviewScheduleId = "";
        _error = null;
        StateHasChanged();
        try
        {
            using var scope = Scopes.CreateScope();
            var review = scope.ServiceProvider.GetRequiredService<SiteReviewService>();
            _review = await review.GetAsync(_familyId, _childId, domain);
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _reviewLoading = false; }
    }

    private void CloseReview()
    {
        _review = null;
        _reviewLoading = false;
        _adultConfirmed = false;
    }

    private async Task BlockDuringScheduleAsync()
    {
        if (_review is null || !Guid.TryParse(_reviewScheduleId, out var scheduleId)) return;
        var domain = _review.Domain;
        if (await BlockSiteAsync(domain, RuleMode.Scheduled, scheduleId))
            await OpenReviewAsync(domain);
    }

    private async Task UnblockReviewAsync()
    {
        if (_review is null || !RuleAvailability.CanUnblock(_review.RuleId)) return;
        var domain = _review.Domain;
        await RemoveRuleAsync(_review.RuleId!.Value, domain);
    }

    private string FaviconUrl(string domain) => "/api/website-review/favicon?domain=" + Uri.EscapeDataString(domain);

    private string CategoryName(string key) => CategoryText.Name(key, key);

    private string OverrideText(string domain) => _overrideByDomain.TryGetValue(domain, out var key)
        ? L["Websites.OverridesCategory", CategoryText.Name(key, key)]
        : L["Websites.Overrides"];

    private string FormatOptional(DateTime? utc) => utc is null ? "—" : FormatLocal(utc.Value);

    private async Task<bool> RunAsync(Func<ParentalDbContext, RuleService, Guid?, Task> action, string? success = null)
    {
        _error = null;
        try
        {
            using var scope = Scopes.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<ParentalDbContext>();
            var rules = scope.ServiceProvider.GetRequiredService<RuleService>();
            var locks = scope.ServiceProvider.GetRequiredService<LockService>();
            var auth = await AuthState.GetAuthenticationStateAsync();
            Guid? parentId = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var id) ? id : null;
            await action(db, rules, parentId);
            await locks.PublishDeviceStateAsync(_familyId, _childId);
            await RefreshAsync();
            if (success is not null) ShowToast(success, false);
            return true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ShowToast(ex.Message, true);
            return false;
        }
    }

    private void ShowToast(string message, bool error)
    {
        _toast = message;
        _toastError = error;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(4000);
            await InvokeAsync(() =>
            {
                if (_toast == message)
                {
                    _toast = null;
                    StateHasChanged();
                }
            });
        });
    }

    private static IEnumerable<string> Parents(string domain)
    {
        var value = domain.Trim().TrimEnd('.').ToLowerInvariant();
        while (value.Length > 0)
        {
            yield return value;
            var dot = value.IndexOf('.');
            if (dot < 0) break;
            value = value[(dot + 1)..];
        }
    }

    private string ScheduleName(Guid? id) => id is { } value ? _schedules.FirstOrDefault(s => s.Id == value)?.Name ?? L["Schedules.ScheduleFallback"] : L["Schedules.NoSchedule"];

    private string FormatLocal(DateTime utc) => Formats.CompactDateTime(
        TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), ResolveTimeZone(_timeZoneId)));

    private static TimeZoneInfo ResolveTimeZone(string? id) => TimeZoneResolver.Resolve(id);

    private string BlockedAttempts(int count) => L[count == 1 ? "Websites.BlockedAttemptOne" : "Websites.BlockedAttemptMany", count];

    private string ActionLabel(string action) => action switch
    {
        "Blocked" => L["Common.Blocked"],
        "Allowed" => L["Common.Allowed"],
        "Removed" => L["Websites.RuleRemoved"],
        _ => action
    };
}
