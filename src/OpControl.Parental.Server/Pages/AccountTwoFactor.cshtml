@page "/account/2fa"
@model AccountTwoFactorModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Settings.TwoFactor"];
}
<div class="page-head">
    <div>
        <div class="eyebrow">@L["TwoFactor.Eyebrow"]</div>
        <h1>@L["Settings.TwoFactor"]</h1>
        <p class="muted">@L["TwoFactor.SubtitleLong"]</p>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert @(Model.IsError ? "danger" : "")">@Model.Message</div>
}

<div class="grid-2">
    <div class="card">
        <div class="card-title-row">
            <h2>@L["Pin.Status"]</h2>
            <span class="pill-soft">@(Model.IsEnabled ? L["TwoFactor.Enabled"] : L["TwoFactor.NotEnabled"])</span>
        </div>
        @if (Model.IsEnabled)
        {
            <p class="muted">@L["TwoFactor.Active"]</p>
            <form method="post" asp-page-handler="Disable" onsubmit="return confirm('@L["TwoFactor.DisableConfirm"]');">
                <button type="submit" class="btn btn-danger">@L["TwoFactor.Disable"]</button>
            </form>
            <form method="post" asp-page-handler="RegenerateRecoveryCodes">
                <button type="submit" class="btn btn-ghost">@L["TwoFactor.Regenerate"]</button>
            </form>
        }
        else
        {
            <p class="muted">@L["TwoFactor.ScanHelp"]</p>
            <div class="qr-box"><img src="@Model.QrDataUri" alt="@L["TwoFactor.QrAlt"]" /></div>
            <div>
                <div class="muted tiny">@L["TwoFactor.ManualKey"]</div>
                <div class="key-box">@Model.ManualKey</div>
            </div>
            <form method="post" asp-page-handler="Enable" class="stack">
                <label class="field"><span>@L["TwoFactor.Code6"]</span><input name="code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" /></label>
                <button type="submit" class="btn btn-primary">@L["TwoFactor.Enable"]</button>
            </form>
        }
    </div>
    <div class="card">
        <h2>@L["TwoFactor.Recovery"]</h2>
        @if (Model.RecoveryCodes.Count > 0)
        {
            <div class="alert">@L["TwoFactor.RecoveryNote"]</div>
            <div class="recovery-list">
                @foreach (var code in Model.RecoveryCodes)
                {
                    <div>@code</div>
                }
            </div>
        }
        else
        {
            <p class="muted">@L["TwoFactor.RecoveryHelp"]</p>
        }
        <a class="btn btn-ghost" href="/settings">@L["Pin.Back"]</a>
    </div>
</div>
