@page "/add-device"
@model AddDeviceModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Add device";
}
<div class="page-head">
    <div>
        <div class="eyebrow">Enrollment</div>
        <h1>Add device</h1>
        <p class="muted">Create a one-time install link, then open it on the child's computer while signed in as an administrator. Links and codes expire and can be used once.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert danger">@Model.Error</div>
}

<div class="grid-2">
    <div class="card">
        <h2>Create an install link</h2>
        @if (Model.Children.Count == 0)
        {
            <p class="muted">Add a child profile first.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Create" class="stack">
                <label class="field">
                    <span>Assign to child</span>
                    <select asp-for="ChildId">
                        @foreach (var child in Model.Children)
                        {
                            <option value="@child.Id">@child.Name</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>Device type</span>
                    <select asp-for="Platform">
                        <option value="Windows">Windows PC</option>
                        <option value="Android" disabled>Android — coming soon</option>
                        <option value="Linux" disabled>Linux — coming soon</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary">Create install link</button>
            </form>
        }
    </div>

    <div class="card">
        <h2>Install link</h2>
        @if (Model.Created is null)
        {
            <p class="muted">Create a link to see the code and QR.</p>
        }
        else
        {
            var mailto = $"mailto:?subject=Install%20Parental%20OpControl&body=Install%20link%3A%20{Uri.EscapeDataString(Model.Created.Link)}%0D%0ACode%3A%20{Model.Created.Code}%0D%0AExpires%3A%20{Uri.EscapeDataString(Model.Created.ExpiresUtc.ToLocalTime().ToString("u"))}";
            <div class="install-link-box" data-token="@Model.Created.Token">
                <div class="install-link-status" id="install-status">
                    <span class="status-dot offline"></span> Waiting for the device…
                </div>
                <label class="field">
                    <span>Link</span>
                    <div class="copy-row">
                        <input readonly value="@Model.Created.Link" id="install-link" />
                        <button type="button" class="ghost-btn" onclick="ocpCopy('install-link')">Copy</button>
                    </div>
                </label>
                <label class="field">
                    <span>One-time code</span>
                    <div class="copy-row">
                        <input readonly value="@Model.Created.Code" id="install-code" class="enroll-code-input" />
                        <button type="button" class="ghost-btn" onclick="ocpCopy('install-code')">Copy</button>
                    </div>
                </label>
                <div class="qr-row">
                    <img src="/i/@Model.Created.Token/qr.png" alt="QR code for the install link" width="180" height="180" />
                    <div>
                        <p class="muted small">Scan this QR with the child's computer or open the link on that PC.</p>
                        <a class="btn btn-primary" href="/i/@Model.Created.Token" target="_blank" rel="noopener">Open link page</a>
                        <a class="ghost-btn" href="@mailto">Email it</a>
                    </div>
                </div>
                <p class="muted small">Expires @Model.Created.ExpiresUtc.ToLocalTime().ToString("MMM d, HH:mm"). The link and code work once.</p>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-title-row">
        <h2>Recent install links</h2>
        <span class="pill-soft">Single use</span>
    </div>
    @if (Model.Links.Count == 0)
    {
        <p class="muted">No install links yet.</p>
    }
    else
    {
        <div class="device-list">
            @foreach (var link in Model.Links)
            {
                var state = link.RevokedUtc is not null ? "Revoked" : link.UsedUtc is not null ? "Connected" : link.ExpiresUtc <= DateTime.UtcNow ? "Expired" : "Waiting";
                <div class="device-row">
                    <span class="status-dot @(state == "Connected" ? "online" : "offline")"></span>
                    <div class="device-main">
                        <div class="device-name">@link.ChildName · @link.Platform</div>
                        <div class="muted tiny">Created @link.CreatedUtc.ToLocalTime().ToString("MMM d, HH:mm") · expires @link.ExpiresUtc.ToLocalTime().ToString("MMM d, HH:mm")</div>
                        @if (link.DeviceName is not null)
                        {
                            <div class="muted tiny">Device: @link.DeviceName</div>
                        }
                    </div>
                    <div class="device-meta">
                        <div class="small">@state</div>
                        @if (link.RevokedUtc is null && link.UsedUtc is null && link.ExpiresUtc > DateTime.UtcNow)
                        {
                            <form method="post" asp-page-handler="Revoke">
                                <input type="hidden" name="linkId" value="@link.Id" />
                                <button type="submit" class="ghost-btn">Revoke</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function ocpCopy(id) {
        const input = document.getElementById(id);
        if (!input) return;
        input.select();
        navigator.clipboard.writeText(input.value).catch(() => document.execCommand('copy'));
    }
    (function () {
        const box = document.querySelector('.install-link-box');
        if (!box) return;
        const token = box.dataset.token;
        const label = document.getElementById('install-status');
        const timer = setInterval(async () => {
            try {
                const response = await fetch('/i/' + encodeURIComponent(token) + '/status', { cache: 'no-store' });
                if (!response.ok) return;
                const status = await response.json();
                if (status.status === 'connected') {
                    label.innerHTML = '<span class="status-dot online"></span> Connected: ' + (status.deviceName || 'device');
                    clearInterval(timer);
                }
            } catch { }
        }, 3000);
    })();
</script>
