@page "/add-device"
@model AddDeviceModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["AddDevice.Title"];
}
<div class="page-head">
    <div>
        <div class="eyebrow">@L["AddDevice.Eyebrow"]</div>
        <h1>@L["Nav.AddDevice"]</h1>
        <p class="muted">@L["AddDevice.Subtitle"]</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert danger">@Model.Error</div>
}

<div class="grid-2">
    <div class="card">
        <h2>@L["AddDevice.CreateLink"]</h2>
        @if (Model.Children.Count == 0)
        {
            <p class="muted">@L["AddDevice.AddChildFirst"]</p>
        }
        else
        {
            <form method="post" asp-page-handler="Create" class="stack">
                <label class="field">
                    <span>@L["AddDevice.AssignChild"]</span>
                    <select asp-for="ChildId">
                        @foreach (var child in Model.Children)
                        {
                            <option value="@child.Id">@child.Name</option>
                        }
                    </select>
                </label>
                <label class="field">
                    <span>@L["AddDevice.DeviceType"]</span>
                    <select asp-for="Platform">
                        <option value="Windows">@L["AddDevice.WindowsPc"]</option>
                        <option value="Android" disabled>@L["AddDevice.AndroidSoon"]</option>
                        <option value="Linux" disabled>@L["AddDevice.LinuxSoon"]</option>
                    </select>
                </label>
                <button type="submit" class="btn btn-primary">@L["AddDevice.CreateButton"]</button>
            </form>
        }
    </div>

    <div class="card">
        <h2>@L["AddDevice.InstallLink"]</h2>
        @if (Model.Created is null)
        {
            <p class="muted">@L["AddDevice.CreateToSee"]</p>
        }
        else
        {
            var mailto = $"mailto:?subject=Install%20Parental%20OpControl&body=Install%20link%3A%20{Uri.EscapeDataString(Model.Created.Link)}%0D%0ACode%3A%20{Model.Created.Code}%0D%0AExpires%3A%20{Uri.EscapeDataString(Model.Created.ExpiresUtc.ToLocalTime().ToString("u"))}";
            <div class="install-link-box" data-token="@Model.Created.Token">
                <div class="install-link-status" id="install-status">
                    <span class="status-dot offline"></span> @L["AddDevice.WaitingDevice"]
                </div>
                <label class="field">
                    <span>@L["AddDevice.Link"]</span>
                    <div class="copy-row">
                        <input readonly value="@Model.Created.Link" id="install-link" />
                        <button type="button" class="ghost-btn" onclick="ocpCopy('install-link')">@L["AddDevice.Copy"]</button>
                    </div>
                </label>
                <label class="field">
                    <span>@L["AddDevice.OneTimeCode"]</span>
                    <div class="copy-row">
                        <input readonly value="@Model.Created.Code" id="install-code" class="enroll-code-input" />
                        <button type="button" class="ghost-btn" onclick="ocpCopy('install-code')">@L["AddDevice.Copy"]</button>
                    </div>
                </label>
                <div class="qr-row">
                    <img src="/i/@Model.Created.Token/qr.png" alt="@L["AddDevice.QrAlt"]" width="180" height="180" />
                    <div>
                        <p class="muted small">@L["AddDevice.ScanQr"]</p>
                        <a class="btn btn-primary" href="/i/@Model.Created.Token" target="_blank" rel="noopener">@L["AddDevice.OpenLink"]</a>
                        <a class="ghost-btn" href="@mailto">@L["AddDevice.EmailIt"]</a>
                    </div>
                </div>
                <p class="muted small">@L["Install.Expires", Formats.CompactDateTime(Model.Created.ExpiresUtc.ToLocalTime())]</p>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-title-row">
        <h2>@L["AddDevice.Recent"]</h2>
        <span class="pill-soft">@L["AddDevice.SingleUse"]</span>
    </div>
    @if (Model.Links.Count == 0)
    {
        <p class="muted">@L["AddDevice.NoLinks"]</p>
    }
    else
    {
        <div class="device-list">
            @foreach (var link in Model.Links)
            {
                var state = link.RevokedUtc is not null ? L["AddDevice.StateRevoked"].Value : link.UsedUtc is not null ? L["Common.Connected"].Value : link.ExpiresUtc <= DateTime.UtcNow ? L["AddDevice.StateExpired"].Value : L["AddDevice.StateWaiting"].Value;
                <div class="device-row">
                    <span class="status-dot @(state == L["Common.Connected"].Value ? "online" : "offline")"></span>
                    <div class="device-main">
                        <div class="device-name">@link.ChildName · @link.Platform</div>
                        <div class="muted tiny">@L["AddDevice.CreatedExpires", Formats.CompactDateTime(link.CreatedUtc.ToLocalTime()), Formats.CompactDateTime(link.ExpiresUtc.ToLocalTime())]</div>
                        @if (link.DeviceName is not null)
                        {
                            <div class="muted tiny">@L["AddDevice.DeviceLabel", link.DeviceName]</div>
                        }
                    </div>
                    <div class="device-meta">
                        <div class="small">@state</div>
                        @if (link.RevokedUtc is null && link.UsedUtc is null && link.ExpiresUtc > DateTime.UtcNow)
                        {
                            <form method="post" asp-page-handler="Revoke">
                                <input type="hidden" name="linkId" value="@link.Id" />
                                <button type="submit" class="ghost-btn">@L["Team.Revoke"]</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<script>
    function ocpCopy(id) {
        const input = document.getElementById(id);
        if (!input) return;
        input.select();
        navigator.clipboard.writeText(input.value).catch(() => document.execCommand('copy'));
    }
    (function () {
        const box = document.querySelector('.install-link-box');
        if (!box) return;
        const token = box.dataset.token;
        const label = document.getElementById('install-status');
        const timer = setInterval(async () => {
            try {
                const response = await fetch('/i/' + encodeURIComponent(token) + '/status', { cache: 'no-store' });
                if (!response.ok) return;
                const status = await response.json();
                if (status.status === 'connected') {
                    label.innerHTML = '<span class="status-dot online"></span> ' + (@Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddDevice.ConnectedLabel"].Value))) + ': ' + (status.deviceName || @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["AddDevice.DeviceFallback"].Value)));
                    clearInterval(timer);
                }
            } catch { }
        }, 3000);
    })();
</script>
