@page "/i/{token}"
@model InstallLinkModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Install.Title"];
}

<div class="auth-card install-card" data-token="@Model.Token">
    <div class="auth-brand">
        <img src="/brand/lockup-color.svg" alt="Parental OpControl" />
    </div>

    @if (Model.Status.Status == "connected")
    {
        <div class="status-mark ok">✓</div>
        <h1>@L["Install.Connected"]</h1>
        <p class="muted">@L["Install.ConnectedBody", Model.Status.DeviceName ?? ""]</p>
        <p class="muted small">@L["Install.ConnectedClose"]</p>
    }
    else if (Model.Status.Status is "expired" or "revoked" or "invalid")
    {
        <div class="status-mark warn">!</div>
        <h1>@(Model.Status.Status == "expired" ? L["Install.LinkExpired"] : Model.Status.Status == "revoked" ? L["Install.LinkRevoked"] : L["Install.LinkInvalid"])</h1>
        <p class="muted">@Model.Status.Error</p>
        <p class="muted small">@L["Install.LinkHelp1"] <strong>@L["Nav.AddDevice"]</strong>@L["Install.LinkHelp2"]</p>
    }
    else if (Model.IsPhone)
    {
        <div class="status-mark">📱</div>
        <h1>@L["Install.AndroidSoon"]</h1>
        <p class="muted">@L["Install.AndroidBody", Model.Status.ChildName ?? ""]</p>
        <p class="muted small">@L["Install.AndroidHelp"]</p>
    }
    else
    {
        <div class="status-mark">🖥️</div>
        <h1>@L["Install.OnThisPc"]</h1>
        <p class="muted">@L["Install.ForChild1"] <strong>@Model.Status.ChildName</strong>@L["Install.ForChild2"]</p>
        <p class="muted small">@L["Install.AdminHelp"]</p>
        @if (Model.HasInstaller)
        {
            <a class="btn btn-primary btn-wide" href="/i/@Model.Token/download">@L["Install.Download"]</a>
        }
        else
        {
            <div class="alert danger">@L["Install.NoInstaller"]</div>
        }
        <p class="muted tiny">@L["Install.Expires", Model.Status.ExpiresUtc.ToLocalTime().ToString("d MMM, t", System.Globalization.CultureInfo.CurrentCulture)]</p>
        <details class="install-fallback">
            <summary>@L["Install.CodeHelp"]</summary>
            <p class="muted small">@L["Install.CodeHelpBody"]</p>
        </details>
    }
</div>

<script>
    (function () {
        const token = @System.Text.Json.JsonSerializer.Serialize(Model.Token);
        if (@System.Text.Json.JsonSerializer.Serialize(Model.Status.Status) !== 'pending') return;
        const timer = setInterval(async () => {
            try {
                const response = await fetch('/i/' + encodeURIComponent(token) + '/status', { cache: 'no-store' });
                if (!response.ok) return;
                const status = await response.json();
                if (status.status !== 'pending') {
                    clearInterval(timer);
                    location.reload();
                }
            } catch { }
        }, 3000);
    })();
</script>
