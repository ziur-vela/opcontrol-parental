@page "/invite/{token}"
@model InviteModel
@using OpControl.Parental.Contracts
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = Model.Kind == InvitationKind.NewFamily ? L["Invite.NewTitle"] : L["Invite.JoinTitle"];
}

@if (Model.Invalid)
{
    <h1 class="auth-title">@L["Invite.Unavailable"]</h1>
    <p class="muted auth-sub">@L["Invite.UnavailableBody"]</p>
    <a class="btn btn-ghost btn-block" href="/login">@L["Invite.GoSignIn"]</a>
}
else if (Model.Kind == InvitationKind.NewFamily)
{
    <h1 class="auth-title">@L["Invite.NewTitle"]</h1>
    <p class="muted auth-sub">@L["Invite.NewBody"]</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert danger">@Model.Error</div>
    }

    <form method="post" class="stack">
        <label class="field"><span>@L["Setup.FamilyName"]</span><input asp-for="Input.FamilyName" placeholder="@L["Setup.FamilyPlaceholder"]" /></label>
        <label class="field"><span>@L["Setup.YourName"]</span><input asp-for="Input.DisplayName" placeholder="@L["Setup.ParentPlaceholder"]" /></label>
        <label class="field"><span>@L["Invite.FirstChild"]</span><input asp-for="Input.ChildName" placeholder="@L["Setup.ChildPlaceholder"]" /></label>
        <label class="field">
            <span>@L["Common.Email"]</span>
            <input asp-for="Input.Email" type="email" autocomplete="username" readonly="@(Model.InvitationEmail is not null)" />
        </label>
        <label class="field"><span>@L["Common.Password"]</span><input asp-for="Input.Password" type="password" autocomplete="new-password" /><span class="muted tiny">@L["Setup.PasswordRule"]</span></label>
        <label class="field"><span>@L["Setup.ConfirmPassword"]</span><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" /></label>
        <button type="submit" class="btn btn-primary btn-block">@L["Setup.CreateFamily"]</button>
    </form>
}
else
{
    <h1 class="auth-title">@L["Invite.JoinHeading", Model.InvitationFamilyName ?? ""]</h1>
    <p class="muted auth-sub">@L["Invite.JoinBody"]</p>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert danger">@Model.Error</div>
    }

    <form method="post" class="stack">
        <label class="field"><span>@L["Setup.YourName"]</span><input asp-for="Input.DisplayName" placeholder="@L["Setup.ParentPlaceholder"]" /></label>
        <label class="field">
            <span>@L["Common.Email"]</span>
            <input asp-for="Input.Email" type="email" autocomplete="username" readonly="@(Model.InvitationEmail is not null)" />
        </label>
        <label class="field"><span>@L["Common.Password"]</span><input asp-for="Input.Password" type="password" autocomplete="new-password" /><span class="muted tiny">@L["Setup.PasswordRule"]</span></label>
        <label class="field"><span>@L["Setup.ConfirmPassword"]</span><input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" /></label>
        <button type="submit" class="btn btn-primary btn-block">@L["Invite.CreateLogin"]</button>
    </form>
}
