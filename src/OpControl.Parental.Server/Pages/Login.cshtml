@page "/login"
@model LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["Login.Title"];
}
<h1 class="auth-title">@L["Login.Title"]</h1>
<p class="muted auth-sub">@L["Login.Subtitle"]</p>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert danger">@Model.Error</div>
}

<form method="post" class="stack">
    <label class="field">
        <span>@L["Common.Email"]</span>
        <input asp-for="Input.Email" type="email" autocomplete="username" />
    </label>
    <label class="field">
        <span>@L["Common.Password"]</span>
        <input asp-for="Input.Password" type="password" autocomplete="current-password" />
    </label>
    <label class="check">
        <input asp-for="Input.RememberMe" /> @L["Login.RememberMe"]
    </label>
    <button type="submit" class="btn btn-primary btn-block">@L["Login.Title"]</button>
</form>

<div class="auth-divider"><span>@L["Login.Or"]</span></div>
<button type="button" class="btn btn-ghost btn-block" disabled title="@L["Login.OAuthOff"]">@L["Login.Google"]</button>
<button type="button" class="btn btn-ghost btn-block" disabled title="@L["Login.OAuthOff"]">@L["Login.Microsoft"]</button>
<p class="muted tiny auth-note">@L["Login.InviteNote"]</p>
