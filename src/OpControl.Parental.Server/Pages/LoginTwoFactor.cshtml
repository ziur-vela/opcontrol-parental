@page "/login/2fa"
@model LoginTwoFactorModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = L["TwoFactor.Title"];
}
<h1 class="auth-title">@L["TwoFactor.Title"]</h1>
<p class="muted auth-sub">@L["TwoFactor.Subtitle"]</p>

@if (Model.Error is not null)
{
    <div class="alert danger">@Model.Error</div>
}

<form method="post" class="stack">
    <input type="hidden" asp-for="RememberMe" />
    <label class="field"><span>@L["TwoFactor.Code"]</span><input asp-for="Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" /></label>
    <label class="check"><input asp-for="UseRecoveryCode" /> @L["TwoFactor.UseRecovery"]</label>
    <button type="submit" class="btn btn-primary btn-block">@L["TwoFactor.Verify"]</button>
</form>
<p class="muted tiny auth-note"><a href="/login">@L["TwoFactor.Back"]</a></p>
