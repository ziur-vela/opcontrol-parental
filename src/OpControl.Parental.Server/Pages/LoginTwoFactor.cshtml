@page "/login/2fa"
@model LoginTwoFactorModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Two-factor sign-in";
}
<h1 class="auth-title">Two-factor sign-in</h1>
<p class="muted auth-sub">Enter the 6-digit code from your authenticator app.</p>

@if (Model.Error is not null)
{
    <div class="alert danger">@Model.Error</div>
}

<form method="post" class="stack">
    <input type="hidden" asp-for="RememberMe" />
    <label class="field"><span>Authenticator code</span><input asp-for="Code" inputmode="numeric" maxlength="6" autocomplete="one-time-code" /></label>
    <label class="check"><input asp-for="UseRecoveryCode" /> Use a recovery code instead</label>
    <button type="submit" class="btn btn-primary btn-block">Verify</button>
</form>
<p class="muted tiny auth-note"><a href="/login">Back to sign in</a></p>
