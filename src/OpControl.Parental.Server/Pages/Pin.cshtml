@page "/pin"
@model PinModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Pin.Title"];
}
<div class="page-head">
    <div>
        <div class="eyebrow">@Model.ChildName</div>
        <h1>@L["Pin.Title"]</h1>
        <p class="muted">@L["Pin.Subtitle"]</p>
    </div>
</div>

@if (Model.Message is not null)
{
    <div class="alert @(Model.IsError ? "danger" : "")">@Model.Message</div>
}

<div class="grid-2">
    <div class="card">
        <h2>@(Model.HasPin ? L["Home.ChangePin"] : L["Home.SetPin"])</h2>
        <form method="post" asp-page-handler="Set" class="stack">
            <input type="hidden" asp-for="ChildId" />
            <label class="field"><span>@L["Pin.New"]</span><input asp-for="NewPin" type="password" inputmode="numeric" maxlength="12" /></label>
            <label class="field"><span>@L["Pin.Confirm"]</span><input asp-for="ConfirmPin" type="password" inputmode="numeric" maxlength="12" /></label>
            <p class="muted tiny">@L["Pin.Rule"]</p>
            <button type="submit" class="btn btn-primary">@L["Pin.Save"]</button>
        </form>
    </div>
    <div class="card">
        <h2>@L["Pin.Status"]</h2>
        <p class="muted">@(Model.HasPin ? L["Pin.IsSet"] : L["Pin.NotSet"])</p>
        @if (Model.HasPin)
        {
            <form method="post" asp-page-handler="Clear">
                <input type="hidden" asp-for="ChildId" />
                <button type="submit" class="btn btn-danger">@L["Pin.Clear"]</button>
            </form>
        }
        <a class="btn btn-ghost" href="/settings">@L["Pin.Back"]</a>
    </div>
</div>
