@page "/schedules"
@model SchedulesModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Schedules.Title"];
}
<div class="page-head">
    <div>
        <div class="eyebrow">@Model.ChildName</div>
        <h1>@L["Schedules.Title"]</h1>
        <p class="muted">@L["Schedules.Subtitle"]</p>
    </div>
</div>

@if (Model.Error is not null)
{
    <div class="alert danger">@Model.Error</div>
}

<div class="grid-2">
    <div class="card">
        <h2>@L["Schedules.AddTitle"]</h2>
        <form method="post" asp-page-handler="Add" class="stack">
            <input type="hidden" asp-for="ChildId" />
            <label class="field"><span>@L["Schedules.Name"]</span><input asp-for="NewName" placeholder="@L["Schedules.NamePlaceholder"]" /></label>
            <div class="field">
                <span>@L["Schedules.Days"]</span>
                <div class="day-grid">
                    @for (var i = 0; i < 7; i++)
                    {
                        <label class="check"><input type="checkbox" name="Days" value="@i" /> @Model.DayNames[i]</label>
                    }
                </div>
            </div>
            <div class="time-grid">
                <label class="field"><span>@L["Schedules.Start"]</span><input asp-for="NewStart" type="time" /></label>
                <label class="field"><span>@L["Schedules.End"]</span><input asp-for="NewEnd" type="time" /></label>
            </div>
            <p class="muted tiny">@L["Schedules.Example"]</p>
            <button type="submit" class="btn btn-primary">@L["Schedules.Add"]</button>
        </form>
    </div>

    <div class="card">
        <div class="card-title-row"><h2>@L["Nav.Schedules"]</h2><span class="pill-soft">@Model.Schedules.Count</span></div>
        @if (Model.Schedules.Count == 0)
        {
            <p class="muted">@L["Schedules.None"]</p>
        }
        else
        {
            <div class="schedule-list">
                @foreach (var schedule in Model.Schedules)
                {
                    <div class="schedule-row">
                        <div class="device-main">
                            <div class="device-name">@schedule.Name</div>
                            <div class="muted tiny">@Model.DaysLabel(schedule.DaysMask) · @SchedulesModel.TimeLabel(schedule.StartMinutes) – @SchedulesModel.TimeLabel(schedule.EndMinutes)</div>
                        </div>
                        <form method="post" asp-page-handler="Toggle" class="inline-form">
                            <input type="hidden" name="id" value="@schedule.Id" />
                            <button class="btn @(schedule.IsEnabled ? "btn-primary" : "btn-ghost")" type="submit">@(schedule.IsEnabled ? L["Schedules.Enabled"] : L["Schedules.Disabled"])</button>
                        </form>
                        <form method="post" asp-page-handler="Delete" class="inline-form" onsubmit="return confirm('@L["Schedules.DeleteConfirm"]');">
                            <input type="hidden" name="id" value="@schedule.Id" />
                            <button class="ghost-btn" type="submit">@L["Common.Delete"]</button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</div>
