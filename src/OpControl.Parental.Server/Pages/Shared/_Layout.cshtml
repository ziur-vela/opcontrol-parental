<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Parental OpControl</title>
    <link rel="icon" type="image/x-icon" href="/brand/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="/css/parental.css" />
</head>
<body class="t-dark">
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand-row">
                <img src="/brand/lockup-ondark.svg" alt="Parental OpControl" class="brand-logo brand-dark" />
                <img src="/brand/lockup-color.svg" alt="Parental OpControl" class="brand-logo brand-light" />
            </div>
            <nav class="nav">
                <a class="nav-link" href="/"><span class="nav-ico">⌂</span> Home</a>
                <a class="nav-link" href="/devices"><span class="nav-ico">▣</span> Devices</a>
                <a class="nav-link" href="/schedules"><span class="nav-ico">◷</span> Schedules</a>
                <a class="nav-link" href="/add-device"><span class="nav-ico">＋</span> Add device</a>
                <a class="nav-link" href="/settings"><span class="nav-ico">⚙</span> Settings</a>
            </nav>
            <div class="sidebar-foot">
                <div class="pill-soft">Job 1 foundation</div>
                <div class="muted small">Rules &amp; reports arrive in later jobs.</div>
            </div>
        </aside>
        <div class="main-col">
            <header class="topbar">
                <div class="topbar-title">@ViewData["Title"]</div>
                <div class="topbar-actions">
                    <button type="button" class="icon-btn" onclick="ocpToggleTheme()" title="Toggle theme" aria-label="Toggle theme">◐</button>
                    <span class="user-chip">@User.FindFirst("display_name")?.Value</span>
                    <form method="post" action="/logout" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="ghost-btn">Sign out</button>
                    </form>
                </div>
            </header>
            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="/js/app.js"></script>
</body>
</html>
