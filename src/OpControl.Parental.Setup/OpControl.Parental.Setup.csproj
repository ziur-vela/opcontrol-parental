<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>OpControl.Parental.Setup</AssemblyName>
    <RootNamespace>OpControl.Parental.Setup</RootNamespace>
    <Version>0.12.1</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(MsiPath)' != ''">
    <EmbeddedResource Include="$(MsiPath)" LogicalName="OpControlParental.msi" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="fonts\*.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\OpControl.Parental.Localization\Loc.cs" Link="Localization\Loc.cs" />
    <EmbeddedResource Include="..\OpControl.Parental.Localization\en.json" LogicalName="OpControl.Parental.Loc.en.json" />
    <EmbeddedResource Include="..\OpControl.Parental.Localization\es-MX.json" LogicalName="OpControl.Parental.Loc.es-MX.json" />
  </ItemGroup>
</Project>
